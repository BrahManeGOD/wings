    local BG = { Enabled = true, Transparency = 0.55, VideoUrl = "https://github.com/BrahManeGOD/wings/raw/refs/heads/main/brah.mp4", AudioId = "__video", AudioVol = 0.5 }
    local BG_URL = "https://github.com/BrahManeGOD/wings/blob/main/brah.jpeg?raw=true"
    local BG_FILE = PATHS.Root .. "/brah.jpg"
    local bgStatus = "Background not loaded yet"
    -- "! wings/gui"            -> ambient audio files (mp3/ogg/wav), cycled from Settings
    -- "! wings/gui/backgrounds" -> videos (mp4/webm/mov) and images (jpg/png) for the panel background
    local GUI_DIR = PATHS.Root .. "/gui"
    local BG_DIR  = GUI_DIR .. "/backgrounds"
    pcall(function() PATHS.ensure(GUI_DIR) end)
    pcall(function() PATHS.ensure(BG_DIR) end)
    local AUDIO_EXTS = { mp3 = true, ogg = true, wav = true, flac = true }
    local VIDEO_EXTS = { mp4 = true, webm = true, mov = true }
    local IMAGE_EXTS = { jpg = true, jpeg = true, png = true, webp = true, bmp = true }
    local function listPlayable(folder, exts)
        local out = {}
        local ok, files = pcall(listfiles, folder)
        if ok and type(files) == "table" then
            for _, p in ipairs(files) do
                local okf, isF = pcall(isfile, p)
                if okf and isF then
