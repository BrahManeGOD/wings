    -- one central loop re-applies everything that games like to reset; each group can be switched off in Settings
    local LOOP_CAM = { FieldOfView = true, CameraMinZoom = true, CameraMaxZoom = true }
    local function loopStep()
        if fullbrightOn and LOOP.Fullbright then pcall(applyFullbrightOnce) end
        if noFogOn and LOOP.NoFog then pcall(applyNoFogOnce) end
        for key in pairs(playerTouched) do
            local sl, ap = playerSliders[key], playerApply[key]
            if sl and ap and key ~= "Health" then
                if (LOOP_CAM[key] and LOOP.Camera) or (not LOOP_CAM[key] and LOOP.Player) then pcall(ap, sl.Value) end
            end
        end
        -- also re-apply values whose per-slider Loop button is On, regardless of LOOP.Player
        for key, looping in pairs(pvLoop) do
            if looping then
                local sl, ap = playerSliders[key], playerApply[key]
                if sl and ap and key ~= "Health" then pcall(ap, sl.Value) end
            end
        end
    end
