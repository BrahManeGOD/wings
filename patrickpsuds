    local CFG_DIR = PATHS.Root .. "/configs"
    local AUTO_FILE = CFG_DIR .. "/_autoload.txt"
    local cfgNames, cfgIdx, cfgAuto, cfgMsg = { "Blank" }, 1, nil, ""
    local function cfgPath(n) return CFG_DIR .. "/" .. n .. ".json" end
    local function listCfgs()
        local keep = cfgNames[cfgIdx]
        cfgNames = { "Blank" }
        if fsReady then
            pcall(function() if not isfolder(CFG_DIR) then makefolder(CFG_DIR) end end)
            local ok, files = pcall(listfiles, CFG_DIR)
            if ok and type(files) == "table" then
                local found = {}
                for _, p in ipairs(files) do
                    local nm = tostring(p):gsub("\\", "/"):match("([^/]+)%.json$")
                    if nm and nm:lower() ~= "blank" then found[#found + 1] = nm end
                end
                table.sort(found, function(a, b) return a:lower() < b:lower() end)
                for _, nm in ipairs(found) do cfgNames[#cfgNames + 1] = nm end
            end
        end
        cfgIdx = 1
        for i, nm in ipairs(cfgNames) do if nm == keep then cfgIdx = i end end
    end
    local function readCfg(n)
        if n == "Blank" then return BLANK end
        if type(readfile) ~= "function" then return nil, "no readfile" end
        local ok, raw = pcall(readfile, cfgPath(n))
        if not ok or type(raw) ~= "string" then return nil, "could not read the file" end
        local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if not ok2 or type(data) ~= "table" then return nil, "the file is not valid JSON" end
        return data
    end
    local function writeCfg(n)
        if type(writefile) ~= "function" then return false, "no writefile" end
        local ok, res = pcall(function()
            pcall(function() if not isfolder(CFG_DIR) then makefolder(CFG_DIR) end end)
            writefile(cfgPath(n), HttpService:JSONEncode(snapshotCfg()))
        end)
        return ok, ok and nil or tostring(res)
    end
    local function setAuto(n)
        cfgAuto = n
        if type(writefile) == "function" then pcall(writefile, AUTO_FILE, n or "") end
    end
    if fsReady and type(readfile) == "function" then
        local ok, raw = pcall(readfile, AUTO_FILE)
        if ok and type(raw) == "string" then
            raw = raw:gsub("%s+", " "):gsub("^ ", ""):gsub(" $", "")
            if raw ~= "" then cfgAuto = raw end
        end
    end
