    -------------------- visibility + per-frame UI --------------------
    -- panel-open effects: blur, music duck, reverb, popup scale - all state in one table slot
    local TweenSvc = game:GetService("TweenService")
    local _FX = {}  -- .blur, .reverb, .vol, .scale, .volTween, .closing
    _FX.scale = Instance.new("UIScale")
    _FX.scale.Scale = 1
    _FX.scale.Parent = panel
    local POP_IN   = TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    local POP_OUT  = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    local FADE     = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
    local function applyPanelEffects(open)
        if open then
            -- popup: panel springs in from 82% scale with a back-ease overshoot
            _FX.scale.Scale = 0.82
            TweenSvc:Create(_FX.scale, POP_IN, { Scale = 1 }):Play()
            -- blur fades in smoothly instead of popping on
            if not _FX.blur then
                local blur = Instance.new("BlurEffect")
                blur.Size = 0
                blur:SetAttribute("BoredomWingsBlur", true)  -- so unload can find and remove it
                blur.Parent = game:GetService("Lighting")
                _FX.blur = blur
            end
            TweenSvc:Create(_FX.blur, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = 12 }):Play()
            -- music ducks down with a smooth fade
            if not _FX.vol then _FX.vol = music.Volume end
            pcall(function()
                if _FX.volTween then _FX.volTween:Cancel() end
                _FX.volTween = TweenSvc:Create(music, FADE,
                    { Volume = math.max(0, (muted and 0 or AUDIO.Volume) * 0.4) })
                _FX.volTween:Play()
            end)
            if not _FX.reverb then
                local rv = Instance.new("ReverbSoundEffect")
                rv.DecayTime  = 1.4
                rv.Density    = 0.6
                rv.Diffusion  = 0.5
                rv.WetLevel   = -6
                rv.DryLevel   = -3
                rv.Parent = music
                _FX.reverb = rv
            end
        else
            -- pop-out: shrink slightly, refreshVisibility keeps the panel visible until this ends
            _FX.closing = true
            TweenSvc:Create(_FX.scale, POP_OUT, { Scale = 0.88 }):Play()
            task.delay(0.17, function()
                _FX.scale.Scale = 1
                if not (UISTATE.guiVisible and UISTATE.panelOpen) then panel.Visible = false end
                _FX.closing = nil
            end)
            if _FX.blur then
                local b = _FX.blur
                TweenSvc:Create(b, POP_OUT, { Size = 0 }):Play()
                task.delay(0.2, function() pcall(function() b:Destroy() end) end)
                _FX.blur = nil
            end
            if _FX.vol ~= nil then
                pcall(function()
                    if _FX.volTween then _FX.volTween:Cancel() end
                    _FX.volTween = TweenSvc:Create(music, FADE, { Volume = muted and 0 or AUDIO.Volume })
                    _FX.volTween:Play()
                end)
                _FX.vol = nil
            end
            if _FX.reverb then pcall(function() _FX.reverb:Destroy() end); _FX.reverb = nil end
        end
    end
    -- Only the center-locked mouse (first person / shift lock) is taken back. Right-mouse camera drag in third person
    -- uses LockCurrentPosition, so it keeps working. Hold Left Alt to hand the mouse back to the camera.
    local function unlockMouse(on)
        if not on or not mouseUnlockOn then return end
        if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter and not UIS:IsKeyDown(Enum.KeyCode.LeftAlt) then
            UIS.MouseBehavior = Enum.MouseBehavior.Default
        end
        UIS.MouseIconEnabled = true
    end
    local function refreshVisibility()
        gui.Enabled = UISTATE.guiVisible
        masterBtn.Visible = UISTATE.guiVisible
        local panelNow = UISTATE.guiVisible and UISTATE.panelOpen
        if panelNow then panel.Visible = true end
        unlockMouse(UISTATE.guiVisible)
        lastNP = nil
        if panelNow ~= UISTATE.lastPanelVisible then
            UISTATE.lastPanelVisible = panelNow
            pcall(applyPanelEffects, panelNow)
        end
        -- during the pop-out animation the panel stays visible; otherwise hide it right away
        if not panelNow and not _FX.closing then
            panel.Visible = false
        end
    end
