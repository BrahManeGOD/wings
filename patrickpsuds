    local function equipAsset(id, label)
        local c = lplr.Character
        if not c then catStatus.Text = "No character" return end
        id = tonumber(id)
        if not id then catStatus.Text = "Not a valid asset id" return end
        catStatus.Text = "Loading " .. tostring(label or id) .. "..."
        local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
        if not ok or type(objs) ~= "table" or #objs == 0 then
            catStatus.Text = "Could not load that asset (private, or GetObjects is unavailable)"
            return
        end
        local fa = rawget(_G, "__BoredomFunnyAvatar")
        local worn, skipped = 0, 0
        local function handle(o)
            if o:IsA("Accessory") then
                if fa and fa.attach and fa.attach(c, o) then
                    worn = worn + 1
                    for _, kid in ipairs(c:GetChildren()) do
                        if kid:IsA("Accessory") and kid:GetAttribute("BoredomFunny") and not kid:GetAttribute("BoredomCat") then
                            kid:SetAttribute("BoredomCat", true)
                            kid:SetAttribute("BoredomAssetId", tostring(id))
                            local hk = kid:FindFirstChild("Handle")
