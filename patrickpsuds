    ---------- config snapshot / apply ----------
    local function isNum(v) return type(v) == "number" and v == v and math.abs(v) < 1e9 end
    local function clampI(v, n) return math.clamp(math.floor(v + 0.5), 1, n) end
    local function toPlain(t)
        local out = {}
        for k, v in pairs(t) do
            local tv = typeof(v)
            if tv == "Color3" then out[k] = toHex(v)
            elseif tv == "number" then if isNum(v) then out[k] = v end
            elseif tv == "boolean" or tv == "string" then out[k] = v end
        end
        return out
    end
    local function snapshotCfg()
        local stops = {}
        for _, c in ipairs(COLORCFG.Stops) do stops[#stops + 1] = toHex(c) end
        local eff = {}
        for _, spec in ipairs(EFFECTS) do
            local fx = effectObjs[spec.title]
            eff[spec.title] = { enabled = fx and fx.Enabled or false, vals = toPlain(effectVals[spec.title]) }
        end
        local player = {}
        for key in pairs(playerTouched) do
            if key ~= "Health" and playerSliders[key] then player[key] = playerSliders[key].Value end
        end
        return {
            v = 1,
            AUDIO = toPlain(AUDIO), FLAP = toPlain(FLAP), TRAIL = toPlain(TRAIL), WINGS = toPlain(WINGS), LIGHT = toPlain(LIGHT),
            COLOR = { ModeIndex = COLORCFG.ModeIndex, Static = toHex(COLORCFG.Static), Stops = stops,
                      Loop = COLORCFG.Loop, Speed = COLORCFG.Speed, Spread = COLORCFG.Spread },
            PresetIndex = currentColorIndex, PlayMode = modeIdx,
            EFFECTS = eff, PLAYER = player, KEYS = toPlain(KEYS), SFX = SFX.snapshot(), MOUSE = mouseUnlockOn,
            LOOP = toPlain(LOOP), TPW = toPlain(TPW), BG = { Enabled = BG.Enabled, Transparency = BG.Transparency, VideoUrl = BG.VideoUrl or "", AudioId = BG.AudioId or "", AudioVol = BG.AudioVol or 0.5 },
        }
    end
    local function mergeInto(dst, src)
        if type(src) ~= "table" then return end
        for k, v in pairs(src) do
            local cur = dst[k]
            if typeof(cur) == "Color3" then
                local c = type(v) == "string" and parseColor(v) or nil
                if c then dst[k] = c end
            elseif type(cur) == "number" then
                if isNum(v) then dst[k] = v end
            elseif cur ~= nil and type(v) == type(cur) and type(v) ~= "table" then
                dst[k] = v
            end
        end
    end
    local BLANK = snapshotCfg()
    local applyCfg
    applyCfg = function(c)
        if type(c) ~= "table" then return false end
        mergeInto(AUDIO, c.AUDIO); mergeInto(FLAP, c.FLAP); mergeInto(TRAIL, c.TRAIL)
        mergeInto(WINGS, c.WINGS); mergeInto(LIGHT, c.LIGHT)
        mergeInto(LOOP, c.LOOP); mergeInto(TPW, c.TPW); mergeInto(BG, c.BG)
        LOOP.Rate = math.clamp(LOOP.Rate, 0, 5)
        BG.Transparency = math.clamp(BG.Transparency, 0, 1)
        AUDIO.RollMode = clampI(AUDIO.RollMode, #ROLLOFF_MODES)
        FLAP.ModeIndex = clampI(FLAP.ModeIndex, 2)
        LIGHT.MaterialIndex = clampI(LIGHT.MaterialIndex, #LIGHT_MATERIALS)
        LIGHT.ClassIndex = clampI(LIGHT.ClassIndex, #LIGHT_CLASSES)
        LIGHT.FaceIndex = clampI(LIGHT.FaceIndex, #LIGHT_FACES)
        local C = c.COLOR
        if type(C) == "table" then
            if isNum(C.ModeIndex) then COLORCFG.ModeIndex = clampI(C.ModeIndex, #COLOR_MODES) end
            local st = type(C.Static) == "string" and parseColor(C.Static) or nil
            if st then COLORCFG.Static = st end
            if type(C.Stops) == "table" then
                local list = {}
                for _, h in ipairs(C.Stops) do
                    local col = type(h) == "string" and parseColor(h) or nil
                    if col and #list < 8 then list[#list + 1] = col end
                end
                if #list >= 2 then COLORCFG.Stops = list end
            end
            if type(C.Loop) == "boolean" then COLORCFG.Loop = C.Loop end
            if isNum(C.Speed) then COLORCFG.Speed = C.Speed end
            if isNum(C.Spread) then COLORCFG.Spread = C.Spread end
        end
        if isNum(c.PresetIndex) then currentColorIndex = clampI(c.PresetIndex, #COLOR_LIST) end
        if isNum(c.PlayMode) then modeIdx = clampI(c.PlayMode, #PLAY_MODES) end
        if type(c.EFFECTS) == "table" then
            for _, spec in ipairs(EFFECTS) do
                local e, fx, vals = c.EFFECTS[spec.title], effectObjs[spec.title], effectVals[spec.title]
                if type(e) == "table" and vals then
                    if type(e.vals) == "table" then
                        for _, p in ipairs(spec.params) do
                            if isNum(e.vals[p[1]]) then vals[p[1]] = e.vals[p[1]] end
                        end
                    end
                    if fx and type(e.enabled) == "boolean" then pcall(function() fx.Enabled = e.enabled end) end
                end
            end
        end
        if c == BLANK then pcall(restorePlayerDefaults) end
        if type(c.PLAYER) == "table" then
            for key, v in pairs(c.PLAYER) do
                local s, ap = playerSliders[key], playerApply[key]
                if s and ap and key ~= "Health" and isNum(v) then
                    v = math.clamp(v, s.Min, s.Max)
                    s.Set(v)
                    pcall(ap, v)
                    playerTouched[key] = true
                end
            end
        end
        if type(c.KEYS) == "table" then
            for _, a in ipairs(ACTIONS) do
                local k = c.KEYS[a.id]
                if type(k) == "string" and (k == "None" or pcall(function() return Enum.KeyCode[k] end)) then KEYS[a.id] = k end
            end
        end
        if type(c.MOUSE) == "boolean" then mouseUnlockOn = c.MOUSE end
        SFX.apply(c.SFX)
        trailTextureBox.Text = TRAIL.Texture or ""
        applyAllTrails(); applyWingLook(); applyLights(); applyAudio(); applyMode(); applyBg()
        rebuildStops(); applyModeVisibility()
        UISTATE.loadingCfg = true
        refreshAll()
        UISTATE.loadingCfg = false
        return true
    end

