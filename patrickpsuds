        if newName == "" then setHint("Type a new name") return end
        local ext = it.name:match("(%.%w+)$") or ".mp3"
        local target = MUSIC_FOLDER .. "/" .. newName:gsub("%.%w+$", "") .. ext
        if target == it.path then return end
        if type(isfile) == "function" and isfile(target) then setHint("A file with that name already exists") return end
        local ok, data = pcall(readfile, it.path)
        if ok and type(data) == "string" and pcall(writefile, target, data) then
            pcall(delfile, it.path)
            setHint("Renamed to " .. target:match("([^/]+)$"))
            refresh()
        else
            setHint("Rename failed")
        end
    end))
    snd.Ended:Connect(BW(function()
        if modeIdx == 2 then snd:Play()
        elseif modeIdx == 3 and #filtered > 0 then playLocal(curIdx % #filtered + 1)
        elseif modeIdx == 4 and #filtered > 0 then playLocal(math.random(#filtered)) end
    end))
    RunService.Heartbeat:Connect(BW(function()
        if mp.frame.Visible then
            local len = snd.TimeLength
            barFill.Size = UDim2.new(len > 0 and math.clamp(snd.TimePosition / len, 0, 1) or 0, 0, 1, 0)
            timeLbl.Text = fmt(snd.TimePosition) .. " / " .. fmt(len)
            stateLbl.Text = snd.IsPlaying and "Playing" or (snd.IsPaused and "Paused" or "Stopped")
        end
        if loopEnd and snd.IsPlaying and snd.TimePosition >= loopEnd then snd.TimePosition = loopStart end
    end))
    mp.onOpen = refresh
    refresh()
    _G.__PantoPlayerSound = snd
    end)()

    -- expose to the Game Stuff tab
    _G.__BoredomWingsExtras = {
        Unload = function()
            pcall(function() local ps = rawget(_G, "__PantoPlayerSound"); if ps then ps:Stop(); ps:Destroy() end end)
            pcall(function() animOverrideIds = {}; stopAnimTracks() end)
            pcall(stopEmote)
            pcall(function() pfEnabled = false end)
            pcall(closeAllPanels)
        end,
        Open = openPanel,
        CloseAll = closeAllPanels,
        Panels = panels,
    }
    print("[Wings] Extra panels loaded: animation, emote, product, subplace, server, waypoint, executor.")
end)()

--========================================================
-- FUNNY AVATAR (R6 "placeholder" try-on, the Avatar-z method)
-- Builds a HumanoidDescription, asks Players:CreateHumanoidModelFromDescriptionAsync for an R6 model,
-- then copies its accessories / clothing / body parts onto your own character, client-side only.
-- Turning it off restores a backup taken just before it was applied.
--========================================================
;(function()
    local Players = game:GetService("Players")
    local lplr = Players.LocalPlayer

    -- The avatar comes from a text template, one item per line:   id - type - adjusting
    --   "0" in adjusting = default placement, otherwise  x,y,z  or  x,y,z,rx,ry,rz  (studs / degrees, relative to where the accessory normally sits)
    --   the " - " separators need a space on both sides, so negative numbers like  0,-0.1,0.1  are fine
    --   types: shirt pants tshirt torso head leftarm rightarm leftleg rightleg facedecal
    --          hat hair face neck shoulder front back waist eyebrow eyelash
    --          idle walk run jump fall climb swim swimidle
    --          skin (id = hex color)
    --   lines are applied top to bottom; lines starting with # or // are ignored
    local DEFAULT_URL = "https://raw.githubusercontent.com/BrahManeGOD/wings/refs/heads/main/README.md"
    -- no built-in fallback on purpose: README.md is the single source of truth for the template
    local ACC_PROP = { hat = "HatAccessory", hair = "HairAccessory", face = "FaceAccessory", neck = "NeckAccessory",
        shoulder = "ShouldersAccessory", front = "FrontAccessory", back = "BackAccessory", waist = "WaistAccessory",
        eyebrow = "EyebrowAccessory", eyelash = "EyelashAccessory" }
    local BODY_PROP = { shirt = "Shirt", pants = "Pants", tshirt = "GraphicTShirt", torso = "Torso", head = "Head",
        leftarm = "LeftArm", rightarm = "RightArm", leftleg = "LeftLeg", rightleg = "RightLeg", facedecal = "Face" }
    local MESH_KINDS = { torso = true, head = true, leftarm = true, rightarm = true, leftleg = true, rightleg = true }
    -- HumanoidDescription animation fields; swimidle has no description field, it only exists on the Animate script
    local ANIM_PROP = { idle = "IdleAnimation", walk = "WalkAnimation", run = "RunAnimation", jump = "JumpAnimation",
        fall = "FallAnimation", climb = "ClimbAnimation", swim = "SwimAnimation" }
    -- Animate stores its Animation objects in folders named idle / walk / run / jump / fall / climb /
    -- swim / swimidle, while the objects themselves are named Animation1 / WalkAnim / ... - the
    -- folder name is the key we care about.
    local function animKey(a)
        local p = a and a.Parent
        local key = p and tostring(p.Name):lower() or ""
        if ANIM_PROP[key] or key == "swimidle" then return key end
        return tostring(a and a.Name or ""):lower()
    end
    local PARTS = { "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg",
        "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm",
        "LeftLowerArm", "RightLowerArm", "LeftHand", "RightHand",
        "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg", "LeftFoot", "RightFoot" }
    local BODY_KIND = { Head = "head", Torso = "torso", ["Left Arm"] = "leftarm", ["Right Arm"] = "rightarm",
        ["Left Leg"] = "leftleg", ["Right Leg"] = "rightleg" }

    local FA = { on = false, busy = false, status = "", token = 0, backup = nil, defaultUrl = DEFAULT_URL, url = DEFAULT_URL, tplStatus = "Template not loaded yet", text = "" }
    _G.__BoredomFunnyAvatar = FA
    local requestFn = request or http_request or (type(syn) == "table" and syn.request) or nil

    local function parseAdjust(txt)
        txt = (txt or ""):gsub("%s+", "")
        if txt == "" or txt == "0" then return nil end
        local nums = {}
        for tok in txt:gmatch("[^,]+") do
            local n = tonumber(tok)
            if not n or n ~= n or math.abs(n) == math.huge then return nil, "bad number '" .. tok .. "'" end
            nums[#nums + 1] = n
        end
        if #nums == 3 then return CFrame.new(nums[1], nums[2], nums[3]) end
        if #nums == 6 then
            return CFrame.new(nums[1], nums[2], nums[3]) * CFrame.Angles(math.rad(nums[4]), math.rad(nums[5]), math.rad(nums[6]))
        end
        return nil, "adjusting must be 0, x,y,z or x,y,z,rx,ry,rz"
    end

    -- returns items (in file order), skipped-line count, list of problems
    function FA.Parse(text)
        local items, problems, skipped = {}, {}, 0
        local n = 0
        for line in (tostring(text) .. "\n"):gmatch("(.-)\r?\n") do
            n = n + 1
            local t = line:gsub("^%s+", ""):gsub("%s+$", "")
            if t ~= "" and t:sub(1, 1) ~= "#" and t:sub(1, 2) ~= "//" then
                local id, kind, rest = t:match("^(%S+)%s+%-%s+(%a+)%s*(.*)$")
                if id then
                    kind = kind:lower()
                    rest = (rest:gsub("^%-%s+", ""))
                    local item = { kind = kind, line = n }
                    local valid = true
                    if kind == "skin" then
                        local hex = id:match("^#?(%x%x%x%x%x%x)$")
                        if hex then item.color = Color3.fromRGB(tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16))
                        else valid = false; problems[#problems + 1] = "line " .. n .. ": skin needs a 6-digit hex color" end
                    elseif ACC_PROP[kind] or BODY_PROP[kind] or ANIM_PROP[kind] or kind == "swimidle" then
                        if id:match("^%d+$") then item.id = id
                        else valid = false; problems[#problems + 1] = "line " .. n .. ": id must be digits" end
                    else
                        valid = false
                        problems[#problems + 1] = "line " .. n .. ": unknown type '" .. kind .. "'"
                    end
                    if valid then
                        local cf, aerr = parseAdjust(rest)
                        if aerr then valid = false; problems[#problems + 1] = "line " .. n .. ": " .. aerr end
                        item.adj = cf
                    end
                    if valid then items[#items + 1] = item end
                else
                    skipped = skipped + 1
                end
            end
        end
        return items, skipped, problems
    end

    -- blocking (run it inside task.spawn): README.md is the ONLY template source.
    -- url argument is ignored on purpose - the template can only be changed by editing the README
    function FA.Reload(_)
        FA.url = DEFAULT_URL
        local text, items, skipped, problems
        if requestFn then
            -- three layers of no-cache: unique query (defeats GitHub CDN), request headers
            -- (defeats the executor's HTTP cache), and a fresh fetch on every button press
            local NC_HEADERS = { ["Cache-Control"] = "no-cache, no-store, max-age=0", ["Pragma"] = "no-cache" }
            for _, u in ipairs({ FA.url .. "?nocache=" .. tostring(os.time()) .. tostring(math.random(1000, 9999)), FA.url }) do
                local ok, res = pcall(requestFn, { Url = u, Method = "GET", Headers = NC_HEADERS })
                local body = ok and type(res) == "table" and (res.Body or res.body) or nil
                local code = ok and type(res) == "table" and tonumber(res.StatusCode or res.statusCode) or 200
                if type(body) == "string" and #body > 0 and code < 400 then
                    local it, sk, pr = FA.Parse(body)
                    if #it > 0 then
                        text, items, skipped, problems = body, it, sk, pr
                        break
                    end
                end
                if text then break end
            end
        end
        if not text then
            FA.items, FA.text = nil, nil
            FA.tplStatus = "Could not fetch the README template - check your internet / executor http."
            return false
        end
        FA.items, FA.text = items, text
        FA.tplStatus = "Template (README.md): " .. #items .. " item(s)" .. (skipped > 0 and (", " .. skipped .. " non-item line(s) ignored") or "")
            .. (#problems > 0 and (", problems: " .. table.concat(problems, "; "):sub(1, 120)) or "")
        return true
    end
    -- never reuse a saved custom link: the only template source is the README link above

    local function isAppearance(c)
        return c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic")
            or c:IsA("BodyColors") or c:IsA("CharacterMesh")
    end
    local function isHeadVisual(c) return c:IsA("SpecialMesh") or c:IsA("Mesh") or c:IsA("Decal") end

    local function capture(character)
        local b = { char = character, items = {}, parts = {}, head = {}, meshes = {} }
        for _, c in ipairs(character:GetChildren()) do
            if isAppearance(c) then
                local ok, cl = pcall(function() return c:Clone() end)
                if ok and cl then b.items[#b.items + 1] = cl end
            end
        end
        for _, n in ipairs(PARTS) do
            local p = character:FindFirstChild(n)
            if p and p:IsA("BasePart") then
                b.parts[n] = { Color = p.Color, Material = p.Material }
                local m = p:FindFirstChildWhichIsA("DataModelMesh")
                if m and not m:GetAttribute("BoredomFunny") then
                    local ok, cl = pcall(function() return m:Clone() end)
                    if ok and cl then b.meshes[n] = cl end
                end
            end
        end
        local head = character:FindFirstChild("Head")
        if head then
            for _, c in ipairs(head:GetChildren()) do
                if isHeadVisual(c) then
                    local ok, cl = pcall(function() return c:Clone() end)
                    if ok and cl then b.head[#b.head + 1] = cl end
                end
            end
        end
        -- keep a copy of the Animate script so custom animations can be put back on Off
        local animate = character:FindFirstChild("Animate")
        if animate then
            local ok, cl = pcall(function() return animate:Clone() end)
            if ok and cl then b.animate = cl end
        end
        return b
    end

    local function clearAppearance(character, alsoHead)
        for _, c in ipairs(character:GetChildren()) do
            if isAppearance(c) then pcall(function() c:Destroy() end) end
        end
        if alsoHead then
            local head = character:FindFirstChild("Head")
            if head then
                for _, c in ipairs(head:GetChildren()) do
                    if isHeadVisual(c) then pcall(function() c:Destroy() end) end
                end
            end
        end
    end

    local function restore(b)
        if not b then return end
        local character = b.char
        if not character or not character.Parent then
            for _, i in ipairs(b.items) do pcall(function() i:Destroy() end) end
            for _, i in ipairs(b.head) do pcall(function() i:Destroy() end) end
            return
        end
        clearAppearance(character, true)
        -- put the original Animate script back (removes any template animations)
        if b.animate then
            local cur = character:FindFirstChild("Animate")
            if cur and cur ~= b.animate then pcall(function() cur:Destroy() end) end
            pcall(function() b.animate.Disabled = false; b.animate.Parent = character end)
        end
        -- drop any funny-avatar body meshes, then put your own ones back
        for _, n in ipairs(PARTS) do
            local p = character:FindFirstChild(n)
            if p and p:IsA("BasePart") then
                local m = p:FindFirstChildWhichIsA("DataModelMesh")
                if m and m:GetAttribute("BoredomFunny") then pcall(function() m:Destroy() end) end
            end
        end
        for n, m in pairs(b.meshes) do
            local p = character:FindFirstChild(n)
            if p and p:IsA("BasePart") and not p:FindFirstChildWhichIsA("DataModelMesh") then
                pcall(function() m.Parent = p end)
            end
        end
        for n, a in pairs(b.parts) do
            local p = character:FindFirstChild(n)
            if p and p:IsA("BasePart") then
                pcall(function() p.Color = a.Color; p.Material = a.Material end)
            end
        end
        local head = character:FindFirstChild("Head")
        if head then
            for _, i in ipairs(b.head) do pcall(function() i.Parent = head end) end
        end
        for _, i in ipairs(b.items) do pcall(function() i.Parent = character end) end
    end

    -- accepts either a setup function (fills a fresh HumanoidDescription) or an existing HumanoidDescription
    local function buildModel(setup)
        local desc
        if typeof(setup) == "Instance" and setup:IsA("HumanoidDescription") then
            desc = setup
        else
            desc = Instance.new("HumanoidDescription")
            pcall(setup, desc)
        end
        local ok, res = pcall(function()
            return Players:CreateHumanoidModelFromDescriptionAsync(desc, Enum.HumanoidRigType.R6)
        end)
        pcall(function() desc:Destroy() end)
        if ok and typeof(res) == "Instance" and res:IsA("Model") then return res end
        return nil, tostring(res)
    end

    -- copies one accessory from the generated model onto the real character and welds it to the matching part
    local function attachAccessory(character, acc, offset)
        local a = acc:Clone()
        local handle = a:FindFirstChild("Handle")
        if not handle then a:Destroy() return false end
        for _, d in ipairs(handle:GetChildren()) do
            if d:IsA("Weld") and d.Name == "AccessoryWeld" then d:Destroy() end
        end
        handle.Anchored = false
        handle.CanCollide = false
        handle.CanTouch = false
        handle.CanQuery = false
        handle.Massless = true
        local head = character:FindFirstChild("Head")
        local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
        local at = handle:FindFirstChildWhichIsA("Attachment")
        local target = at and character:FindFirstChild(at.Name, true)
        local part = (target and target.Parent:IsA("BasePart") and target.Parent) or head or torso
        if target and target.Parent:IsA("BasePart") then
            handle.CFrame = target.WorldCFrame * at.CFrame:Inverse()
        elseif at and part then
            handle.CFrame = part.CFrame * CFrame.new(at.Position)
        elseif part then
            handle.CFrame = part.CFrame
        end
        if offset then handle.CFrame = handle.CFrame * (typeof(offset) == "CFrame" and offset or CFrame.new(offset)) end
        if part then
            local w = Instance.new("WeldConstraint")
            w.Part0, w.Part1, w.Parent = handle, part, handle
        end
        for _, q in ipairs(a:GetDescendants()) do
            if q:IsA("BasePart") and q ~= handle then
                q.CanCollide, q.CanTouch, q.CanQuery, q.Massless = false, false, false, true
                local w = Instance.new("WeldConstraint")
                w.Part0, w.Part1, w.Parent = q, handle, q
            end
        end
        a:SetAttribute("BoredomFunny", true)
        a.Parent = character
        return true
    end

    FA.attach = attachAccessory

    local function transfer(character, model, onlyAccessories, offset, opts)
        opts = opts or {}
        local n = 0
        for _, c in ipairs(model:GetChildren()) do
            if c:IsA("Accessory") then
                if attachAccessory(character, c, offset) then n = n + 1 end
            elseif not onlyAccessories and not (opts.skipColors and c:IsA("BodyColors")) and (c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic")
                or c:IsA("BodyColors") or c:IsA("CharacterMesh")) then
                local cl = c:Clone()
                cl:SetAttribute("BoredomFunny", true)
                cl.Parent = character
                n = n + 1
            end
        end
        if not onlyAccessories then
            -- face decal lives inside Head, not as a direct child of the model
            if opts.copyFace then
                local mh, ch = model:FindFirstChild("Head"), character:FindFirstChild("Head")
                if mh and ch then
                    for _, c in ipairs(mh:GetChildren()) do
                        if c:IsA("Decal") then
                            local cl = c:Clone()
                            cl:SetAttribute("BoredomFunny", true)
                            cl.Parent = ch
                            n = n + 1
                        end
                    end
                end
            end
            -- body parts: the HumanoidDescription mesh IDs are baked into the model's parts as
            -- SpecialMeshes, not instances we can clone by class - copy them part by part
            for _, nm in ipairs(PARTS) do
                local kind = BODY_KIND[nm]
                if not opts.meshKinds or not kind or opts.meshKinds[kind] then
                    local mp = model:FindFirstChild(nm)
                    local cp = character:FindFirstChild(nm)
                    if mp and cp and mp:IsA("BasePart") and cp:IsA("BasePart") then
                        local mesh = mp:FindFirstChildWhichIsA("DataModelMesh")
                        if mesh then
                            pcall(function()
                                local old = cp:FindFirstChildWhichIsA("DataModelMesh")
                                if old then old:Destroy() end
                                local cl = mesh:Clone()
                                cl:SetAttribute("BoredomFunny", true)
                                cl.Parent = cp
                            end)
                            n = n + 1
                        end
                    end
                end
            end
        end
        return n
    end

    local function paintSkin(character, color)
        if not color then return end
        for _, n in ipairs(PARTS) do
            local p = character:FindFirstChild(n)
            if p and p:IsA("BasePart") then pcall(function() p.Color = color end) end
        end
    end

    local function setColors(d, color)
        d.HeadColor, d.TorsoColor = color, color
        d.LeftArmColor, d.RightArmColor = color, color
        d.LeftLegColor, d.RightLegColor = color, color
    end

    -- Animations are played by the "Animate" script, not stored on accessories. Swap the ids on
    -- its Animation children, then clone-restart it so the tracks are reloaded with the new ids.
    local function applyAnimations(character, anims)
        if not anims or not next(anims) then return 0 end
        local animate = character:FindFirstChild("Animate")
        if not animate then return 0 end
        local changed = 0
        for _, a in ipairs(animate:GetDescendants()) do
            if a:IsA("Animation") then
                local id = anims[animKey(a)]
                if id and id ~= "" and id ~= "0" then
                    pcall(function() a.AnimationId = "rbxassetid://" .. tostring(id) end)
                    changed = changed + 1
                end
            end
        end
        if changed == 0 then return 0 end
        local ok, cl = pcall(function() return animate:Clone() end)
        if ok and cl then
            pcall(function() cl.Disabled = false end)
            pcall(function() animate:Destroy() end)
            pcall(function() cl.Parent = character end)
        end
        return changed
    end

    -- Avatar-Z method: NO Humanoid:ApplyDescription (games block that from the client).
    -- Instead: build a full R6 model with Players:CreateHumanoidModelFromDescriptionAsync and
    -- copy its accessories / clothing / body colors onto your own character, client-side only.
    -- Items with a custom offset ("adjusting") are welded on afterwards one by one.
    local function apply(isRespawn)
        local character = lplr.Character
        local hum = character and character:FindFirstChildOfClass("Humanoid")
        if not (character and hum and character.Parent) then FA.status = "Your character is not ready." return false end

        FA.token = FA.token + 1
        local my = FA.token
        FA.busy = true
        FA.status = "Backing up your avatar..."
        local backup = capture(character)

        FA.status = "Reading the README template..."
        if not FA.Reload() then
            FA.busy = false
            FA.status = "Template load failed. " .. (FA.tplStatus or "")
            return false
        end
        if my ~= FA.token then FA.busy = false return false end

        local body, skin = {}, nil
        local anims = {}     -- [kind] = animation id, applied to the Animate script afterwards
        local accIds = {}    -- [HumanoidDescription prop] = { id, ... }
        local adjUnits = {}  -- offset-adjusted items, applied with the weld path afterwards
        local meshKinds = {} -- body meshes that the template actually specifies
        for _, it in ipairs(FA.items or {}) do
            if it.kind == "skin" then skin = it.color
            elseif BODY_PROP[it.kind] then
                body[BODY_PROP[it.kind]] = tonumber(it.id)
                if MESH_KINDS[it.kind] then meshKinds[it.kind] = true end
            elseif ANIM_PROP[it.kind] then anims[it.kind] = tostring(it.id)
            elseif it.kind == "swimidle" then anims.swimidle = tostring(it.id)
            elseif ACC_PROP[it.kind] then
                if it.adj then
                    adjUnits[#adjUnits + 1] = it
                else
                    local list = accIds[ACC_PROP[it.kind]]
                    if not list then list = {}; accIds[ACC_PROP[it.kind]] = list end
                    list[#list + 1] = tostring(it.id)
                end
            end
        end
        if not next(accIds) and not next(body) and not skin and not next(anims) and #adjUnits == 0 then
            FA.busy = false
            FA.status = "The template has no usable items."
            return false
        end

        FA.status = "Applying template..."
        local function setup(d)
            for prop, ids in pairs(accIds) do pcall(function() d[prop] = table.concat(ids, ",") end) end
            for k, v in pairs(body) do pcall(function() d[k] = v end) end
            for k, v in pairs(anims) do local prop = ANIM_PROP[k]; if prop then pcall(function() d[prop] = tonumber(v) end) end end
            if skin then pcall(function() setColors(d, skin) end) end
        end
        -- only rebuild the body when the template actually changes it (an animations-only
        -- template must not wipe the avatar you are wearing)
        local hasBody = next(accIds) ~= nil or next(body) ~= nil or skin ~= nil
        local model, errM
        local worn, failures = 0, {}
        if hasBody then
            model, errM = buildModel(setup)
            if model then
                -- tell the user when accessory ids in the template did not load (a common cause is
                -- pasting a Handle mesh id such as 807... instead of the catalog hat/shirt id)
                local expectedAcc = 0
                for _, list in pairs(accIds) do expectedAcc = expectedAcc + #list end
                if expectedAcc > 0 then
                    local gotAcc = 0
                    for _, c in ipairs(model:GetChildren()) do if c:IsA("Accessory") then gotAcc = gotAcc + 1 end end
                    if gotAcc < expectedAcc then
                        failures[#failures + 1] = (expectedAcc - gotAcc) .. " accessory id(s) did not load - re-copy the avatar (mesh ids do not work as accessory ids)"
                    end
                end
                local hasFace = body.Face ~= nil
                clearAppearance(character, false)
                local head = character:FindFirstChild("Head")
                if head then
                    for _, c in ipairs(head:GetChildren()) do
                        if isHeadVisual(c) and (c:GetAttribute("BoredomFunny") or (c:IsA("Decal") and hasFace)
                            or (c:IsA("DataModelMesh") and meshKinds.head)) then
                            pcall(function() c:Destroy() end)
                        end
                    end
                end
                worn = transfer(character, model, false, nil, {
                    skipColors = skin == nil, meshKinds = meshKinds, copyFace = hasFace })
                paintSkin(character, skin)
                pcall(function() model:Destroy() end)
            else
                failures[#failures + 1] = "CreateHumanoidModelFromDescription: " .. tostring(errM):sub(1, 60)
            end
        end
        if my ~= FA.token then FA.busy = false return false end
        local animCount = applyAnimations(character, anims)
        worn = worn + animCount

        for _, it in ipairs(adjUnits) do
            if my ~= FA.token then FA.busy = false return false end
            FA.status = "Placing (offset): " .. it.kind .. " " .. tostring(it.id)
            local m, err = buildModel(function(d) d[ACC_PROP[it.kind]] = tostring(it.id) end)
            if m then
                for _, c in ipairs(m:GetChildren()) do
                    if c:IsA("Accessory") and attachAccessory(character, c, it.adj) then worn = worn + 1 end
                end
                pcall(function() m:Destroy() end)
            else
                failures[#failures + 1] = it.kind .. " " .. tostring(it.id) .. " (" .. tostring(err):sub(1, 40) .. ")"
            end
        end

        if my ~= FA.token then FA.busy = false return false end
        if not character.Parent then
            FA.busy = false
            FA.status = "Character changed while building."
            return false
        end

        FA.backup = backup
        FA.on = true
        FA.busy = false
        FA.status = "On: " .. worn .. " item(s) applied" .. (#failures > 0 and (", failed: " .. table.concat(failures, "; ")) or "") .. "."
        if #failures > 0 then warn("[Wings] funny avatar: " .. table.concat(failures, " | ")) end
        return true
    end

    local function remove()
        FA.token = FA.token + 1
        local b = FA.backup
        FA.backup = nil
        FA.on = false
        FA.busy = false
        if b then restore(b) FA.status = "Off. Your own avatar was restored."
        else FA.status = "Off." end
    end

    FA.usernameOverride = ""  -- set by UI; when non-empty Toggle() fetches that player's avatar

    local function applyFromUsername(username)
        local character = lplr.Character
        local hum = character and character:FindFirstChildOfClass("Humanoid")
        if not (character and hum and character.Parent) then FA.status = "Character not ready." return false end
        FA.busy = true
        FA.status = "Looking up " .. username .. "..."
        local ok1, uid = pcall(function() return game:GetService("Players"):GetUserIdFromNameAsync(username) end)
        if not ok1 or not uid then FA.busy = false; FA.status = "User not found: " .. tostring(uid):sub(1,60); return false end
        FA.status = "Fetching avatar for " .. username .. " (" .. tostring(uid) .. ")..."
        local ok2, desc = pcall(function() return game:GetService("Players"):GetHumanoidDescriptionFromUserId(uid) end)
        if not ok2 or not desc then FA.busy = false; FA.status = "Could not fetch avatar: " .. tostring(desc):sub(1,60); return false end
        -- read the animation bundle before the description is destroyed
        local anims = {}
        for kind, prop in pairs(ANIM_PROP) do
            local v = desc[prop]
            local id = (type(v) == "number" and v > 0) and tostring(math.floor(v)) or (type(v) == "string" and v:match("%d+") or nil)
            if id and id ~= "0" then anims[kind] = id end
        end
        FA.token = FA.token + 1; local my = FA.token
        FA.backup = capture(character)   -- taken BEFORE anything is cleared, so Off can restore
        FA.status = "Applying " .. username .. "'s avatar..."
        local model, errM = buildModel(desc)
        pcall(function() desc:Destroy() end)
        local ok3
        if model then
            clearAppearance(character, true)
            local n = transfer(character, model, false)
            pcall(function() model:Destroy() end)
            if my ~= FA.token then FA.busy = false; return false end
            local a = applyAnimations(character, anims)
            ok3 = (n + a) > 0
            if not ok3 then FA.status = "That avatar had nothing copyable." end
        else
            ok3 = false
            FA.status = "Model build failed: " .. tostring(errM):sub(1, 60)
        end
        if my ~= FA.token then FA.busy = false; return false end
        FA.on = true; FA.busy = false
        if ok3 then FA.status = "On: wearing " .. username .. "'s avatar." end
        return ok3
    end

    -- reads your CURRENT character (client-side, works in every game incl. catalog avatar creator)
    -- and turns it into template lines: every accessory slot, clothes, body meshes, skin, animations.
    -- Catalog IDs come from Humanoid:GetAppliedDescription() (what the game actually applied); if a
    -- worn accessory is not in there, the player's saved avatar description is used for its ID, so
    -- hats/hair/etc. no longer silently disappear (their handle only stores a mesh id, not the item id).
    local ACC_KIND_FROM_PROP = {}
    for kind, prop in pairs(ACC_PROP) do ACC_KIND_FROM_PROP[prop] = kind end
    local BODY_KIND_FROM_PROP = {}
    for kind, prop in pairs(BODY_PROP) do BODY_KIND_FROM_PROP[prop] = kind end
    local SKIN_PARTS = { "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg",
        "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
        "LeftHand", "RightHand", "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg",
        "LeftFoot", "RightFoot" }

    local function idFromUrl(s)
        if type(s) == "number" then return s > 0 and tostring(math.floor(s)) or nil end
        if type(s) ~= "string" then return nil end
        local id = s:match("^rbxassetid://(%d+)") or s:match("(%d+)%D*$") or s:match("(%d+)")
        if id == "0" then return nil end
        return id
    end
    -- description fields can hold several ids: "123,456"
    local function idsFromValue(v, add, kind)
        if type(v) == "number" then
            if v > 0 then add(tostring(math.floor(v)), kind) end
        elseif type(v) == "string" then
            for id in v:gmatch("%d+") do if id ~= "0" then add(id, kind) end end
        end
    end
    local function accKind(a)
        local ok, t = pcall(function() return a.AccessoryType end)
        if ok and typeof(t) == "EnumItem" then
            local n = tostring(t.Name):lower()
            if ACC_PROP[n] then return n end
            -- layered clothing (Shirt/Pants/Jacket/...) has no classic template slot; skip it
            if n ~= "unknown" then return nil end
        end
        local h = a and a:FindFirstChild("Handle")
        local at = h and h:FindFirstChildWhichIsA("Attachment")
        local n = at and at.Name or ""
        if n:find("Hair") then return "hair" end
        if n:find("Hat") then return "hat" end
        if n:find("Face") then return "face" end
        if n:find("Neck") then return "neck" end
        if n:find("Shoulder") then return "shoulder" end
        if n:find("Front") then return "front" end
        if n:find("Back") then return "back" end
        if n:find("Waist") then return "waist" end
        return "hat"
    end
    -- catalog id of an accessory already worn. The Handle mesh id is NOT the catalog id, so only
    -- trust ids that were explicitly stored (catalog equip button / executor tags).
    local function accCatalogId(a)
        local h = a:FindFirstChild("Handle")
        local ATTRS = { "BoredomAssetId", "AssetId", "AccessoryId", "CatalogId", "OriginalAssetId", "ItemId" }
        for _, key in ipairs(ATTRS) do
            for _, inst in ipairs({ a, h }) do
                if inst then
                    local id = idFromUrl(inst:GetAttribute(key))
                    if id then return id end
                end
            end
        end
        return nil
    end
    -- current animation ids from the Animate script (fallback when the description has none)
    local function currentAnims(character)
        local out = {}
        local animate = character:FindFirstChild("Animate")
        if not animate then return out end
        for _, a in ipairs(animate:GetDescendants()) do
            if a:IsA("Animation") then
                local key = animKey(a)
                if ANIM_PROP[key] or key == "swimidle" then
                    local id = idFromUrl(a.AnimationId)
                    if id then out[key] = id end
                end
            end
        end
        return out
    end

    local function exportCharacter(character, desc, onlyKinds)
        local lines, seen, unresolved, descKindCount, descAnims = {}, {}, {}, {}, {}
        local function add(id, kind)
            id = tostring(id or "")
            if id ~= "" and id ~= "0" and not seen[id .. kind] then
                seen[id .. kind] = true
                lines[#lines + 1] = id .. " - " .. kind .. " - 0"
            end
        end
        local descSkin
        if desc then
            for prop, kind in pairs(ACC_KIND_FROM_PROP) do
                if not onlyKinds or onlyKinds[kind] then
                    local v
                    pcall(function() v = desc[prop] end)
                    local before = #lines
                    idsFromValue(v, add, kind)
                    local got = #lines - before
                    descKindCount[kind] = got
                    if onlyKinds and got == 0 then unresolved[kind] = true end
                end
            end
            if not onlyKinds then
                for prop, kind in pairs(BODY_KIND_FROM_PROP) do
                    local v
                    pcall(function() v = desc[prop] end)
                    idsFromValue(v, add, kind)
                end
                for kind, prop in pairs(ANIM_PROP) do
                    local v
                    pcall(function() v = desc[prop] end)
                    local id = idFromUrl(v)
                    if id then descAnims[kind] = id end
                end
                local tally, bestHex, bestN = {}, nil, 0
                for _, prop in ipairs({ "HeadColor", "TorsoColor", "LeftArmColor", "RightArmColor", "LeftLegColor", "RightLegColor" }) do
                    local c
                    pcall(function() c = desc[prop] end)
                    if typeof(c) == "Color3" then
                        local hex = string.format("%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
                        tally[hex] = (tally[hex] or 0) + 1
                    end
                end
                for hex, cnt in pairs(tally) do if cnt > bestN then bestHex, bestN = hex, cnt end end
                if bestHex then descSkin = bestHex end
            end
        end
        if onlyKinds then return table.concat(lines, "\n"), unresolved end

        local charSkin
        if character then
            local sh = character:FindFirstChildOfClass("Shirt")
            if sh then add(idFromUrl(sh.ShirtTemplate), "shirt") end
            local pa = character:FindFirstChildOfClass("Pants")
            if pa then add(idFromUrl(pa.PantsTemplate), "pants") end
            local ts = character:FindFirstChildOfClass("ShirtGraphic")
            if ts then add(idFromUrl(ts.Graphic), "tshirt") end
            local head = character:FindFirstChild("Head")
            local face = head and head:FindFirstChildWhichIsA("Decal")
            if face then add(idFromUrl(face.Texture), "facedecal") end
            -- accessories: take any explicitly stored catalog ids; when there are more worn
            -- accessories of a type than the description knows about, the extras are unresolved
            local unknownByKind = {}
            for _, a in ipairs(character:GetChildren()) do
                if a:IsA("Accessory") then
                    local kind = accKind(a)
                    if kind then
                        local id = accCatalogId(a)
                        if id then add(id, kind)
                        else unknownByKind[kind] = (unknownByKind[kind] or 0) + 1 end
                    end
                end
            end
            for kind, unknown in pairs(unknownByKind) do
                if unknown > (descKindCount[kind] or 0) then unresolved[kind] = true end
            end
            -- body part meshes
            for partName, kind in pairs(BODY_KIND) do
                local p = character:FindFirstChild(partName)
                local m = p and p:IsA("BasePart") and p:FindFirstChildWhichIsA("DataModelMesh")
                if m then add(idFromUrl(m.MeshId), kind) end
            end
            for _, cm in ipairs(character:GetChildren()) do
                if cm:IsA("CharacterMesh") then
                    local kind = tostring(cm.BodyPart.Name):lower()
                    if BODY_PROP[kind] then add(idFromUrl(cm.MeshId), kind) end
                end
            end
            -- skin: most common body color as hex
            local tally, bestHex, bestN = {}, nil, 0
            for _, partName in ipairs(SKIN_PARTS) do
                local p = character:FindFirstChild(partName)
                if p and p:IsA("BasePart") then
                    local c = p.Color
                    local hex = string.format("%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
                    tally[hex] = (tally[hex] or 0) + 1
                end
            end
            for hex, cnt in pairs(tally) do if cnt > bestN then bestHex, bestN = hex, cnt end end
            if bestHex and bestN >= 2 then charSkin = bestHex end
            -- animations: the applied description wins; the live Animate script only fills gaps
            local anims = {}
            for k, v in pairs(currentAnims(character)) do anims[k] = v end
            for k, v in pairs(descAnims) do anims[k] = v end
            for k, v in pairs(anims) do add(v, k) end
        else
            for k, v in pairs(descAnims) do add(v, k) end
        end
        local skin = charSkin or descSkin
        if skin then lines[#lines + 1] = skin .. " - skin - 0" end
        -- collapse duplicates for kinds that can only have one template line (last one wins;
        -- the lines read from the character are added after the description, so they win)
        local DEDUPE = { shirt = true, pants = true, tshirt = true, facedecal = true, torso = true, head = true,
            leftarm = true, rightarm = true, leftleg = true, rightleg = true, skin = true,
            idle = true, walk = true, run = true, jump = true, fall = true, climb = true, swim = true, swimidle = true }
        local keep, out = {}, {}
        for i, line in ipairs(lines) do
            local kind = line:match("%s%-%s(%a+)%s%-%s")
            if kind and DEDUPE[kind] then keep[kind] = i end
        end
        for i, line in ipairs(lines) do
            local kind = line:match("%s%-%s(%a+)%s%-%s")
            if not (kind and DEDUPE[kind]) or keep[kind] == i then out[#out + 1] = line end
        end
        if #out == 0 then return nil, unresolved end
        return table.concat(out, "\n"), unresolved
    end

    local function descFromHumanoid(hum)
        if not hum then return nil end
        local ok, d = pcall(function() return hum:GetAppliedDescription() end)
        if ok and typeof(d) == "Instance" and d:IsA("HumanoidDescription") then return d end
        return nil
    end
    local function missingNote(unresolved)
        local list = {}
        for kind in pairs(unresolved or {}) do list[#list + 1] = kind end
        if #list == 0 then return nil end
        table.sort(list)
        return "No catalog id found for: " .. table.concat(list, ", ") .. " (add it by hand)"
    end

    function FA.ExportCurrent()
        local character = lplr.Character
        if not character then return nil, "No character" end
        local desc = descFromHumanoid(character:FindFirstChildOfClass("Humanoid"))
        local txt, unresolved = exportCharacter(character, desc)
        pcall(function() if desc then desc:Destroy() end end)
        -- accessories the game did not put in the applied description: borrow the IDs from the
        -- player's own saved avatar (this is the Avatar-Z conversion trick)
        if unresolved and next(unresolved) then
            local own
            local ok, d = pcall(function() return Players:GetHumanoidDescriptionFromUserId(lplr.UserId) end)
            if ok and typeof(d) == "Instance" and d:IsA("HumanoidDescription") then own = d end
            if own then
                local extra, still = exportCharacter(nil, own, unresolved)
                pcall(function() own:Destroy() end)
                if extra and extra ~= "" then
                    txt = (txt and txt ~= "") and (txt .. "\n" .. extra) or extra
                end
                unresolved = still
            end
        end
        if not txt or txt == "" then return nil, "Nothing copyable" end
        return txt, missingNote(unresolved)
    end

    function FA.ExportUsername(username)
        username = tostring(username or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if username == "" then return nil, "Type a username first" end
        local ok1, uid = pcall(function() return Players:GetUserIdFromNameAsync(username) end)
        if not ok1 or not uid then return nil, "User not found: " .. tostring(uid):sub(1, 60) end
        local ok2, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserId(uid) end)
        if not ok2 or typeof(desc) ~= "Instance" or not desc:IsA("HumanoidDescription") then
            return nil, "Could not fetch that avatar: " .. tostring(desc):sub(1, 60)
        end
        local txt, unresolved = exportCharacter(nil, desc)
        pcall(function() desc:Destroy() end)
        if not txt or txt == "" then return nil, username .. " has nothing copyable" end
        return txt, missingNote(unresolved)
    end

    function FA.Toggle()
        if FA.busy then
            FA.token = FA.token + 1   -- cancel a build that is still running
            FA.busy = false
            FA.status = "Cancelled."
            return
        end
        if FA.on then
            remove()
        else
            local uname = (FA.usernameOverride or ""):gsub("^%s+",""):gsub("%s+$","")
            if uname ~= "" then
                task.spawn(function()
                    local ok, e = pcall(applyFromUsername, uname)
                    if not ok then FA.busy = false; FA.status = "Error: " .. tostring(e) end
                end)
            else
                task.spawn(function() local ok, e = pcall(apply) if not ok then FA.busy = false FA.status = "Error: " .. tostring(e) end end)
            end
        end
    end

    task.spawn(function() pcall(FA.Reload) end)

    lplr.CharacterAdded:Connect(BW(function()
        FA.backup = nil
        if FA.on then
            FA.on = false
            task.wait(2)
            task.spawn(function() local ok, e = pcall(apply, true) if not ok then FA.busy = false FA.status = "Error: " .. tostring(e) end end)
        end
    end))
end)()
