        local ok = pcall(delfile, selectedPath)
        hubStatus.Text = ok and "Deleted" or "Delete failed"
        selectedPath = nil
        if srcIdx == 0 then runSearch() end
    end))
    execPanel.onOpen = function() if srcIdx == 0 then runSearch() end end
    runSearch()
    end)()

