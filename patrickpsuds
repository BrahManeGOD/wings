        animTracks, animInstances, animCurrent = {}, {}, nil
    end
    local function rebuildAnimTracks()
        stopAnimTracks()
        local animator = getAnimator()
        if not animator then return false, "No Humanoid Animator (respawn or wait)" end
        local count = 0
        for slot, id in pairs(animOverrideIds) do
            local a = Instance.new("Animation")
            a.AnimationId = "rbxassetid://" .. tostring(id)
            local ok, track = pcall(function() return animator:LoadAnimation(a) end)
            if ok and track then
                track.Priority = Enum.AnimationPriority.Action4
                track.Looped = true
                animTracks[slot] = track
                animInstances[slot] = a
                count += 1
            end
        end
        if count == 0 then return false, "These animations are not compatible with this rig" end
        return true, count
    end
    local function animStateTick()
        if next(animTracks) == nil then return end
        local animator, h = getAnimator()
        if not animator or not h then stopAnimTracks() return end
        local state = h:GetState()
        local cat
        if state == Enum.HumanoidStateType.Jumping then cat = "jump"
        elseif state == Enum.HumanoidStateType.Freefall then cat = "fall"
        elseif state == Enum.HumanoidStateType.Swimming then cat = "swim"
        elseif state == Enum.HumanoidStateType.Climbing then cat = "climb"
        elseif h.MoveDirection.Magnitude > 0.05 then cat = animTracks.run and "run" or "walk"
        else cat = "idle" end
        if not animTracks[cat] then cat = nil end
        local track = cat and animTracks[cat] or nil
        if track ~= animCurrent then
            if animCurrent then pcall(function() animCurrent:Stop() end) end
            animCurrent = track
            if track then pcall(function() track:Play() end) end
        end
    end
    local function applyAnim(bundle, slot)
        if slot == "all" then
            animOverrideIds = {}
            for _, item in ipairs(bundle.items or {}) do
                local key = ANIM_TYPE[item.assetType]
                if key then animOverrideIds[key] = item.id end
            end
        else
            local target
            for _, item in ipairs(bundle.items or {}) do
                if ANIM_TYPE[item.assetType] == slot then target = item.id break end
            end
            if not target then animStatus.Text = bundle.name .. " has no " .. tostring(slot) .. " slot." return end
            animOverrideIds[slot] = target
        end
        if next(animOverrideIds) == nil then
            animStatus.Text = bundle.name .. " has no usable animation slots."
            return
        end
        local ok, result = rebuildAnimTracks()
        if ok then
            animStatus.Text = "Applied " .. bundle.name .. (slot == "all" and " (all slots)" or (" -> " .. ANIM_LABEL[slot]))
        else
            animStatus.Text = tostring(result)
        end
    end
