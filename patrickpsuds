            fogSaved = { FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart, atm = {} }
            noFogOn = true
            applyNoFogOnce()
        elseif not on and noFogOn then
            noFogOn = false
            if fogSaved then
                pcall(function() Lighting.FogEnd = fogSaved.FogEnd; Lighting.FogStart = fogSaved.FogStart end)
                for a, v in pairs(fogSaved.atm) do
