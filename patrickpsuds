    local function fetchBundle(id)
        id = tostring(id)
        if animCache[id] then return animCache[id] end
        if animCache[id] == false then return nil end
        local data = httpJSON("https://catalog.roblox.com/v1/bundles/" .. id .. "/details", 2)
        if data and data.bundleType == "AvatarAnimations" then
            animCache[id] = data
            saveAnimCache()
            return data
        end
        if data then animCache[id] = false end
        return nil
    end
    -- runs the same job for every item at once (staggered a little) instead of one request after another
    local function parallelEach(list, fn, timeout)
        local left = #list
        for i, v in ipairs(list) do
            task.spawn(function()
                if i > 1 then task.wait((i - 1) * 0.03) end
                pcall(fn, v, i)
                left = left - 1
            end)
        end
        local t0 = os.clock()
        while left > 0 and os.clock() - t0 < (timeout or 15) do task.wait(0.05) end
    end

    local animToken, animQueryIds = 0, {}

    -- one request for the whole page of bundles; any id the batch call misses is fetched in parallel
    local function fetchBundles(ids)
        local need = {}
        for _, id in ipairs(ids) do
            local k = tostring(id)
            if animCache[k] == nil then need[#need + 1] = k end
        end
        if #need == 0 then return end
        local data = httpJSON("https://catalog.roblox.com/v1/bundles/details?bundleIds=" .. table.concat(need, ","), 2)
        local arr = type(data) == "table" and (data.data or data) or nil
        local got = {}
        if type(arr) == "table" then
            for _, b in ipairs(arr) do
                if type(b) == "table" and b.id then
                    local k = tostring(b.id)
                    got[k] = true
                    animCache[k] = (b.bundleType == "AvatarAnimations") and b or false
                end
            end
        end
        local rest = {}
        for _, k in ipairs(need) do if not got[k] then rest[#rest + 1] = k end end
        if #rest > 0 then parallelEach(rest, function(k) fetchBundle(k) end, 14) end
        saveAnimCache()
    end

    local function loadAnimations(query)
        query = query or ""
        animToken = animToken + 1
        local token = animToken
        animLoading, animQuery = true, query
        animStatus.Text = query == "" and "Loading curated packs..." or ("Searching '" .. query .. "'...")
        renderAnimations()
        task.spawn(function()
            local qkey = query:lower()
            local ids = animQueryIds[qkey]
            local err
            if not ids then
                ids = {}
                if query == "" then
                    for _, id in ipairs(KNOWN_ANIM_BUNDLES) do ids[#ids + 1] = id end
                else
                    local data
                    data, err = httpJSON("https://catalog.roblox.com/v1/search/items?category=Bundles&limit=30&sortType=Relevance&keyword=" .. urlEncode(query), 2)
                    if token ~= animToken then return end
                    if data and type(data.data) == "table" then
                        for _, item in ipairs(data.data) do
                            if item.itemType == "Bundle" then ids[#ids + 1] = item.id end
                        end
                        animQueryIds[qkey] = ids
                    else
                        animStatus.Text = "Catalog search failed (" .. tostring(err) .. "), showing curated packs."
                        for _, id in ipairs(KNOWN_ANIM_BUNDLES) do ids[#ids + 1] = id end
                    end
                end
            end
            local function collect()
                local out, seen = {}, {}
                for _, id in ipairs(ids) do
                    local k = tostring(id)
                    if not seen[k] and type(animCache[k]) == "table" then
                        seen[k] = true
                        out[#out + 1] = animCache[k]
                        if #out >= 30 then break end
                    end
                end
                return out
            end
            animBundles = collect()          -- anything already cached shows instantly
            if token == animToken then renderAnimations() end
            fetchBundles(ids)
            if token ~= animToken then return end
            animBundles = collect()
            animLoading = false
            if #animBundles == 0 then
                animStatus.Text = "No animation packages found." .. (err and (" (" .. tostring(err) .. ")") or " Roblox may be rate limiting; try again shortly.")
            else
                animStatus.Text = "Found " .. #animBundles .. " animation package(s). Choose All or one slot."
            end
            renderAnimations()
        end)
    end
