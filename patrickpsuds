    local function sanitizeFile(n)
        n = tostring(n or ""):gsub("[^%w%-_ ]", "_"):gsub("^%s+", ""):gsub("%s+$", "")
        return n
    end
    local function listSaved(filter)
        local out = {}
        if type(listfiles) ~= "function" then return out end
        local ok, files = pcall(listfiles, SCRIPT_DIR)
        if not ok or type(files) ~= "table" then return out end
        for _, f in ipairs(files) do
            f = tostring(f):gsub("\\", "/")
            local name = f:match("([^/]+)$") or f
            local ext = (name:match("%.(%w+)$") or ""):lower()
            if (ext == "lua" or ext == "luau" or ext == "txt") and (not filter or filter == "" or name:lower():find(filter:lower(), 1, true)) then
                out[#out + 1] = { name = name, path = SCRIPT_DIR .. "/" .. name, saved = true }
            end
        end
        table.sort(out, function(a, b) return a.name:lower() < b.name:lower() end)
        return out
    end
    local function httpText(url)
        if type(requestFn) ~= "function" then return nil, "executor has no request function" end
        local ok, res = pcall(requestFn, { Url = url, Method = "GET" })
        if not ok then return nil, tostring(res) end
        local body = type(res) == "table" and (res.Body or res.body) or nil
        local code = type(res) == "table" and tonumber(res.StatusCode or res.statusCode) or 200
        if type(body) ~= "string" or body == "" or code >= 400 then return nil, "HTTP " .. tostring(code) end
        return body
    end
    local function findArray(d, depth)
        if type(d) ~= "table" then return nil end
        if #d > 0 and type(d[1]) == "table" then return d end
        if depth >= 3 then return nil end
        for _, v in pairs(d) do
            local r = findArray(v, depth + 1)
            if r then return r end
        end
        return nil
    end
    local function firstString(e, keys)
        for _, k in ipairs(keys) do
            if type(e[k]) == "string" and e[k] ~= "" then return e[k] end
        end
        return nil
    end
    local renderHub
    renderHub = function()
        clearList(hubList)
        local pa, pb2 = hubPg.range(#hubItems, tostring(hubItems))
        for i = pa, pb2 do
            local it = hubItems[i]
            local picked = it.saved and it.path == selectedPath
            mkButton(hubList, it.name, UDim2.new(0, 0, 0, 30), UDim2.new(1, -8, 0, 30), function()
                selectedPath = it.saved and it.path or nil
                if it.saved then
                    local ok, body = pcall(readfile, it.path)
                    if ok and type(body) == "string" then
                        editor.Text = body
                        nameBox.Text = it.name:gsub("%.%w+$", "")
                        hubStatus.Text = "Loaded " .. it.name
                    else
                        hubStatus.Text = "Could not read " .. it.name
                    end
                elseif it.code then
                    editor.Text = it.code
                    hubStatus.Text = "Loaded " .. it.name
                elseif it.url then
                    hubStatus.Text = "Downloading " .. it.name .. "..."
                    task.spawn(function()
                        local body, err = httpText(it.url)
                        if body then editor.Text = body; hubStatus.Text = "Loaded " .. it.name
                        else hubStatus.Text = "Download failed: " .. tostring(err) end
                    end)
                end
                renderHub()
            end, picked and Color3.fromRGB(70, 105, 76) or nil).TextXAlignment = Enum.TextXAlignment.Left
        end
    end
    hubPg.onChange = renderHub
    local function runSearch()
        hubToken = hubToken + 1
        local token = hubToken
        if srcIdx == 0 then
            hubItems = listSaved(hubSearch.Text)
            hubStatus.Text = #hubItems .. " saved script(s) in " .. SCRIPT_DIR
            renderHub()
            return
        end
        local src = sources[srcIdx]
        if not src or type(src.url) ~= "string" or src.url == "" then
            hubItems = {}
            hubStatus.Text = (src and src.name or "Source") .. ": no API url yet. Put one in ! wings/script_sources.json ({q} = search text)."
            renderHub()
            return
        end
        hubStatus.Text = "Searching " .. src.name .. "..."
        task.spawn(function()
            local data, err = httpJSON((src.url:gsub("{q}", function() return urlEncode(hubSearch.Text) end)), 2)
            if token ~= hubToken then return end
            local arr = data and findArray(data, 0)
            local out = {}
            if arr then
                for _, e in ipairs(arr) do
                    if type(e) == "table" then
                        out[#out + 1] = {
                            name = firstString(e, { "title", "name", "scriptName", "slug" }) or "Script",
                            code = firstString(e, { "script", "source", "code", "content" }),
                            url = firstString(e, { "rawScript", "raw", "rawUrl", "raw_url", "scriptUrl", "url" }),
                        }
                    end
                end
            end
            hubItems = out
            hubStatus.Text = #out > 0 and (#out .. " result(s) from " .. src.name) or (src.name .. ": nothing found" .. (err and (" (" .. tostring(err) .. ")") or ""))
            renderHub()
        end)
    end
    srcBtn.MouseButton1Click:Connect(BW(function()
        srcIdx = (srcIdx + 1) % (#sources + 1)
        srcBtn.Text = "Source: " .. (srcIdx == 0 and "Saved scripts" or tostring(sources[srcIdx].name))
        runSearch()
    end))
    hubGo.MouseButton1Click:Connect(BW(runSearch))
    hubSearch.FocusLost:Connect(BW(function(enter) if enter then runSearch() end end))
    saveBtn.MouseButton1Click:Connect(BW(function()
        if type(writefile) ~= "function" then hubStatus.Text = "writefile is unavailable" return end
        local n = sanitizeFile(nameBox.Text)
        if n == "" then hubStatus.Text = "Type a name first" return end
        local path = SCRIPT_DIR .. "/" .. n .. ".lua"
        local ok = pcall(writefile, path, editor.Text)
        hubStatus.Text = ok and ("Saved " .. n .. ".lua") or "Save failed"
        if ok then selectedPath = path; if srcIdx == 0 then runSearch() end end
    end))
    delBtn.MouseButton1Click:Connect(BW(function()
        if not selectedPath then hubStatus.Text = "Select a saved script first" return end
