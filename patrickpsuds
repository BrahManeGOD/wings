local function applyLights()
    if not LIGHT.Enabled or #boneParts == 0 then
        for _, l in ipairs(lightObjs) do l:Destroy() end
        lightObjs = {}
        return
    end
    local cls = LIGHT_CLASSES[LIGHT.ClassIndex]
    if #lightObjs == 0 or lightObjs[1].ClassName ~= cls then
        for _, l in ipairs(lightObjs) do l:Destroy() end
        lightObjs = {}
        for _, bone in ipairs(boneParts) do
            local l = Instance.new(cls)
            l.Name = "WingLight"
            l.Parent = bone
            lightObjs[#lightObjs + 1] = l
        end
    end
    for _, l in ipairs(lightObjs) do
        l.Enabled = true
        pcall(function() l.Range = LIGHT.Range end)
        pcall(function() l.Shadows = LIGHT.Shadows end)
        pcall(function() l.Angle = LIGHT.Angle end) -- Spot/Surface only
        pcall(function() l.Face = Enum.NormalId[LIGHT_FACES[LIGHT.FaceIndex]] end)
    end
end

