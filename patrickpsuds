            elseif o:IsA("Shirt") or o:IsA("Pants") or o:IsA("ShirtGraphic") then
                local rec = { replaced = {} }
                for _, old in ipairs(c:GetChildren()) do
                    if old.ClassName == o.ClassName and not old:GetAttribute("BoredomCat") then
                        local okc, cl = pcall(function() return old:Clone() end)
                        if okc and cl then rec.replaced[#rec.replaced + 1] = cl end
                        old:Destroy()
                    end
                end
                local cl = o:Clone()
                cl:SetAttribute("BoredomCat", true)
                cl:SetAttribute("BoredomAssetId", tostring(id))
                cl.Parent = c
                rec.inst = cl
                catEquipped[#catEquipped + 1] = rec
                worn = worn + 1
            elseif o:IsA("Decal") then
                local head = c:FindFirstChild("Head")
                if head then
