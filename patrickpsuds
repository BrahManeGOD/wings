            if gui.Enabled then pcall(function() _BGX.snd:Resume() end)
            else pcall(function() _BGX.snd:Pause() end) end
        end
    end))
    -- play a video+audio asset already on disk at `path` (stored in _BGX to avoid a top-level local slot)
    _BGX.activate = function(path)
        local ok, asset = pcall(getAsset, path)
        if not (ok and asset and asset ~= "") then
            bgStatus = "getcustomasset failed: " .. tostring(asset); return false
        end
        _BGX.video.Video = asset
        -- FIX for "no errors but nothing plays": the VideoFrame must be preloaded AND
        -- report Loaded before :Play(), otherwise it just stays black forever.
        pcall(function() game:GetService("ContentProvider"):PreloadAsync({ _BGX.video }) end)
        local loaded = false
        local t0 = os.clock()
        while os.clock() - t0 < 10 do
            if _BGX.video.Loaded then loaded = true break end
            task.wait(0.1)
        end
        if not loaded then
            -- some executors only flip Loaded right after Play - give it one grace try
            pcall(function() _BGX.video:Play() end)
            task.wait(1)
            loaded = _BGX.video.Loaded or _BGX.video.TimePosition > 0
        end
        if not loaded then
            bgStatus = "Video never reported Loaded (re-encode as H.264 .mp4?)"
            return false
        end
        pcall(function() _BGX.video:Play() end)
        applyBg()
        -- also pipe audio: set the ambient sound to the same asset
        -- Roblox Sound can play .ogg/.mp3 natively; .mp4/.webm audio track is not decoded
        -- by Sound, but we try anyway — executor audio support varies
        if BG.AudioId == "" or BG.AudioId == "__video" then
            BG.AudioId = "__video"
            if _BGX.snd.SoundId ~= asset then _BGX.snd.SoundId = asset end
            _BGX.snd.Volume = math.clamp(BG.AudioVol or 0.5, 0, 10)
            if gui.Enabled then pcall(function() _BGX.snd:Play() end) end
        end
        return true
    end
    _BGX.loadVideo = function(url)
        if url == "" then
            _BGX.video.Video = ""; _BGX.video.Visible = false
            if BG.AudioId == "__video" then
                BG.AudioId = ""; pcall(function() _BGX.snd:Stop() end)
            end
            applyBg(); return
        end
        bgStatus = "Loading video..."
        -- bare asset id
        if url:match("^%d+$") then
            _BGX.video.Video = "rbxassetid://" .. url
            pcall(function() _BGX.video:Play() end); applyBg()
            bgStatus = "Video set (asset id)"; return
        end
        -- rbxassetid:// URI
        if url:match("^rbxassetid://") then
            _BGX.video.Video = url
            pcall(function() _BGX.video:Play() end); applyBg()
            bgStatus = "Video set (rbxassetid)"; return
        end
        -- local file already cached
        if type(isfile) == "function" then
            local okf, has = pcall(isfile, url)
            if okf and has then
                if _BGX.activate(url) then bgStatus = "Video loaded from local file" end
                return
            end
        end
        -- need to download
        local req = requestFn
        if type(req) ~= "function" or type(writefile) ~= "function" or type(getAsset) ~= "function" then
            bgStatus = "Need request + writefile + getcustomasset for video URLs"; return
        end
        task.spawn(function()
            bgStatus = "Downloading video (this may take a moment)..."
            -- derive extension from URL path, ignore query string
            local path_part = url:match("^[^%?#]+") or url
            local ext = (path_part:match("%.(%a%a%a%a?)$") or "webm"):lower()
            if not (ext=="webm" or ext=="mp4" or ext=="ogg" or ext=="mov") then ext = "webm" end
            -- ensure cache dir
            pcall(function()
                local cdir = PATHS.Root .. "/.cache"
                local okd, hasd = pcall(isfolder, cdir)
                if not (okd and hasd) then makefolder(cdir) end
            end)
            local savePath = PATHS.Root .. "/.cache/panto_bg." .. ext
            -- request with browser-like headers so CDNs / GitHub don't 403
            local ok, res = pcall(req, {
                Url     = url,
                Method  = "GET",
                Headers = {
                    ["User-Agent"]      = "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
                    ["Accept"]          = "*/*",
                    ["Accept-Encoding"] = "identity",
                },
            })
            if not ok then bgStatus = "Request error: " .. tostring(res):sub(1,80); return end
            local code = type(res) == "table" and tonumber(res.StatusCode or res.statusCode) or nil
            local body = type(res) == "table" and (res.Body or res.body) or nil
            if code and code ~= 200 then
                bgStatus = "Download failed: HTTP " .. tostring(code); return
            end
            if type(body) ~= "string" or #body < 32 then
                bgStatus = "Download failed: empty body (" .. tostring(#(body or "")) .. " bytes)"; return
            end
            bgStatus = string.format("Saving %d KB...", math.ceil(#body / 1024))
            if not pcall(writefile, savePath, body) then
                bgStatus = "writefile failed — executor may block large writes"; return
            end
            bgStatus = string.format("Downloaded %d KB, loading...", math.ceil(#body / 1024))
            if _BGX.activate(savePath) then
                bgStatus = string.format("Video ready (%d KB, .%s)", math.ceil(#body / 1024), ext)
            end
        end)
    end
    local function bgFromFile()
        if type(getAsset) ~= "function" then return false end
        local ok, asset = pcall(getAsset, BG_FILE)
        if ok and asset and asset ~= "" then
            bgImage.Image = asset
            applyBg()
            return true
        end
        return false
    end
    local function loadBg(force)
        task.spawn(function()
            if type(getAsset) ~= "function" or type(writefile) ~= "function" then
                bgStatus = "Executor lacks getcustomasset/writefile, no background"
                return
            end
            if not force and type(isfile) == "function" then
                local okf, has = pcall(isfile, BG_FILE)
                if okf and has and bgFromFile() then bgStatus = "Background loaded from cache" return end
            end
            local req = request or http_request or (type(syn) == "table" and syn.request) or nil
            if type(req) ~= "function" then bgStatus = "Executor has no request function" return end
            bgStatus = "Downloading background..."
            local ok, res = pcall(req, { Url = BG_URL, Method = "GET" })
            local body = ok and type(res) == "table" and (res.Body or res.body) or nil
            local code = ok and type(res) == "table" and tonumber(res.StatusCode or res.statusCode) or nil
            local isImg = type(body) == "string" and #body > 16
                and (body:sub(1, 3) == "\255\216\255" or body:sub(1, 4) == "\137PNG")
            if not isImg then
                bgStatus = "Download failed (" .. tostring(code or (ok and "not an image" or tostring(res))) .. ")"
                return
            end
            local okw = pcall(writefile, BG_FILE, body)
            if okw and bgFromFile() then bgStatus = "Background downloaded" else bgStatus = "Could not save or load the image" end
        end)
    end
