            emoteStatus.Text = "Found " .. #emoteResults .. " emote(s) (cached)."
            renderEmotes()
            return
        end
        emoteLoading = true
        emoteStatus.Text = "Searching emotes..."
        renderEmotes()
        task.spawn(function()
            local out = {}
            -- first try the endpoint that returns names with the search, so no per-emote lookups are needed
            local data, err = httpJSON("https://catalog.roblox.com/v1/search/items/details?category=Emotes&limit=30&keyword=" .. urlEncode(query), 2)
            if token ~= emoteToken then return end
            local first = data and type(data.data) == "table" and data.data[1]
            if first and (first.name or first.Name) then
                for _, item in ipairs(data.data) do
                    if #out >= 24 then break end
                    local e = { id = item.id, name = item.name or item.Name or ("Emote " .. tostring(item.id)) }
                    emoteCache[tostring(item.id)] = e
                    out[#out + 1] = e
                end
            else
                data, err = httpJSON("https://catalog.roblox.com/v1/search/items?category=Emotes&limit=28&keyword=" .. urlEncode(query), 2)
                if token ~= emoteToken then return end
                local missing, order = {}, {}
                if data and type(data.data) == "table" then
                    for _, item in ipairs(data.data) do
                        if #order >= 24 then break end
                        local id = tostring(item.id)
                        order[#order + 1] = id
