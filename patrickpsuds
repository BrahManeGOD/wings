-- every adjustable trail property except Color / LightEmission (those follow color + beat each frame)
local function applyTrailSettings(trail)
    local wt = WINGS.Transparency
    trail.Enabled        = TRAIL.Enabled and not WINGS.Hidden
    trail.Lifetime       = TRAIL.Lifetime
    trail.MinLength      = TRAIL.MinLength
    trail.LightInfluence = TRAIL.LightInfluence
    trail.FaceCamera     = TRAIL.FaceCamera
    trail.WidthScale     = NumberSequence.new(TRAIL.Width)
    trail.Texture        = TRAIL.Texture or ""
    pcall(function() trail.Brightness = TRAIL.Brightness end)
    local s = 1 - (1 - wt) * (1 - TRAIL.StartTransparency)
    local e = 1 - (1 - wt) * (1 - TRAIL.EndTransparency)
    trail.Transparency = NumberSequence.new(s, e)
end

