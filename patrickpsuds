    local function setFly(on)
        local h, c = getHum()
        local root = c and c:FindFirstChild("HumanoidRootPart")
        if on and not root then return false end
        flyOn = on
        if flyConn then flyConn:Disconnect(); flyConn = nil end
        if flyBV then flyBV:Destroy(); flyBV = nil end
        if flyBG then flyBG:Destroy(); flyBG = nil end
        if on then
            flyBV = Instance.new("BodyVelocity")
            flyBV.Name = "BoredomFly"
            flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            flyBV.P = 2500
            flyBV.Parent = root
            flyBG = Instance.new("BodyGyro")
            flyBG.Name = "BoredomFlyGyro"
            flyBG.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
            flyBG.P = 2000
            flyBG.Parent = root
            flyConn = RunService.RenderStepped:Connect(BW(function()
                local cam = workspace.CurrentCamera
                local hh, cc = getHum()
                local rt = cc and cc:FindFirstChild("HumanoidRootPart")
                if not (flyOn and cam and rt and flyBV and flyBG) then return end
                local dir = Vector3.zero
                if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
                if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.new(0, 1, 0) end
                if dir.Magnitude > 0 then dir = dir.Unit * flySpeed end
                flyBV.Velocity = dir
                flyBG.CFrame = CFrame.new(rt.Position, rt.Position + cam.CFrame.LookVector)
                if hh then hh.PlatformStand = true end
            end))
        else
            local hh = getHum()
            if hh then hh.PlatformStand = false end
        end
        return true
    end

