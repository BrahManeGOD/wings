    --====================================================
    -- one look for every panel: same fonts, grey translucent buttons and live wing-color text as the Master panel
    --====================================================
    do
        local themedExtra = {}
        local function spread(c) return math.max(c.R, c.G, c.B) - math.min(c.R, c.G, c.B) end
        local function register(o) themedExtra[#themedExtra + 1] = o end
        local function styleText(o)
            o.Font = Enum.Font.Arcade
            o.TextStrokeColor3 = Color3.new(0, 0, 0)
            o.TextStrokeTransparency = 0
            register(o)
        end
        local function restyleNow(o)
            if not o.Parent then return end
            if o:IsA("TextButton") then
                local size = o.TextSize
                styleText(o)
                local isHeader = o.Parent:IsA("Frame") and o.Parent.Parent == host and o.Size.Y.Offset == 30
                if isHeader or spread(o.BackgroundColor3) < 0.10 then
                    o.BackgroundColor3 = Color3.new(.5, .5, .5)
                    o.BackgroundTransparency = isHeader and 0.35 or 0.5
                else
                    o.BackgroundTransparency = 0.3
                end
                if not isHeader then
                    o.TextScaled = true
                    local c = Instance.new("UITextSizeConstraint")
                    c.MaxTextSize = math.max(size, 12)
                    c.MinTextSize = 6
                    c.Parent = o
                end
            elseif o:IsA("TextLabel") then
                styleText(o)
            elseif o:IsA("TextBox") then
                if o.MultiLine then
                    o.BackgroundColor3 = Color3.new(.08, .08, .08)
                    o.BackgroundTransparency = 0.3
                    o.TextColor3 = Color3.new(1, 1, 1)
                else
                    styleText(o)
                    o.BackgroundColor3 = Color3.new(.5, .5, .5)
                    o.BackgroundTransparency = 0.5
                    o.BorderSizePixel = 0
                    o.TextYAlignment = Enum.TextYAlignment.Center
                    o.TextScaled = true
                    local c = Instance.new("UITextSizeConstraint")
                    c.MaxTextSize = 16
                    c.MinTextSize = 6
                    c.Parent = o
                end
            elseif o:IsA("ScrollingFrame") then
                o.BackgroundColor3 = Color3.new(.12, .12, .12)
                o.BackgroundTransparency = 0.5
            elseif o:IsA("Frame") then
                if o.Parent == host then
                    o.BackgroundColor3 = Color3.new(.12, .12, .12)
                    o.BackgroundTransparency = 0.35
                elseif o.Parent and o.Parent.Parent == host then
                    o.BackgroundTransparency = 1      -- the body frame: let the panel show through
