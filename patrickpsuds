function PATHS.clean(raw)
    raw = tostring(raw or ""):gsub("\\", "/"):gsub("^%s+", ""):gsub("%s+$", ""):gsub("^/+", ""):gsub("/+$", "")
    return raw
end
function PATHS.ensure(path)                                                    -- makefolder one segment at a time
    local acc = ""
    for seg in tostring(path):gmatch("[^/]+") do
        acc = (acc == "") and seg or (acc .. "/" .. seg)
        pcall(function() if not isfolder(acc) then makefolder(acc) end end)
    end
end
