--========================================================
-- CUSTOM HIT / DEATH SOUNDS: random file from a folder you choose
--========================================================
;(function()
    local Players = game:GetService("Players")
    local SoundService = game:GetService("SoundService")
    local Debris = game:GetService("Debris")
    local lplr = Players.LocalPlayer
    local EXT = { mp3 = true, wav = true, ogg = true }

    local function newKind(folder)
        return { Enabled = false, Folder = folder, Volume = 1, Pitch = 1, Variance = 0.1, Cooldown = 0.25,
                 Selected = {}, files = {}, last = 0, lastFile = nil, status = "" }
    end
    local S = { Hit = newKind(PATHS.Root .. "/hit sounds"), Death = newKind(PATHS.Root .. "/death sounds"), conns = {} }
    _G.__BoredomSfx = S
    local cache = {}

    function S.scan(k)
        k.files = {}
        if not fsReady then k.status = "File functions unavailable" return end
        local folder = k.Folder:gsub("\\", "/"):gsub("/+$", "")
        pcall(function() if not isfolder(folder) then makefolder(folder) end end)
        local ok, list = pcall(listfiles, folder)
        if not ok or type(list) ~= "table" then k.status = "Could not list " .. folder return end
        for _, p in ipairs(list) do
            local norm = tostring(p):gsub("\\", "/")
            local name = norm:match("([^/]+)$")
            local ext = name and name:match("%.(%w+)$")
            if ext and EXT[ext:lower()] then k.files[#k.files + 1] = { name = name, path = p } end
        end
        table.sort(k.files, function(a, b) return a.name:lower() < b.name:lower() end)
        k.status = #k.files .. " file(s) in " .. folder
    end

    local function pick(k)
        local pool = {}
        for _, f in ipairs(k.files) do
            if k.Selected[f.name] then pool[#pool + 1] = f end
        end
        if #pool == 0 then pool = k.files end      -- nothing ticked = every file in the folder
        if #pool == 0 then return nil end
        if #pool == 1 then return pool[1] end
        local f
        repeat f = pool[math.random(1, #pool)] until f.name ~= k.lastFile
        return f
    end

    function S.play(k)
        if #k.files == 0 then S.scan(k) end
        local f = pick(k)
        if not f then k.status = "No sound files in the folder" return end
        k.lastFile = f.name
        local asset = cache[f.path]
        if not asset then
            local ok, res = pcall(getAsset, f.path)
            if not ok or type(res) ~= "string" or res == "" then k.status = "Could not load " .. f.name return end
            asset = res
            cache[f.path] = res
        end
        local s = Instance.new("Sound")
        s.SoundId = asset
        s.Volume = k.Volume
        s.PlaybackSpeed = math.max(0.1, k.Pitch * (1 + (math.random() * 2 - 1) * k.Variance))
        s.Parent = SoundService
        s.Ended:Connect(BW(function() s:Destroy() end))
        s:Play()
        Debris:AddItem(s, 60)
        k.status = "Played " .. f.name
    end

    function S.fire(name)
        local k = S[name]
        if not k.Enabled then return end
        if os.clock() - k.last < k.Cooldown then return end
        k.last = os.clock()
        S.play(k)
    end

    local function hook(char)
        for _, c in ipairs(S.conns) do pcall(function() c:Disconnect() end) end
        S.conns = {}
        local hum = char:WaitForChild("Humanoid", 10)
        if not hum then return end
        local last = hum.Health
        S.conns[#S.conns + 1] = hum.HealthChanged:Connect(BW(function(h)
            if h < last - 0.01 and h > 0 then S.fire("Hit") end
            last = h
        end))
        S.conns[#S.conns + 1] = hum.Died:Connect(BW(function() S.fire("Death") end))
    end
    lplr.CharacterAdded:Connect(BW(hook))
    if lplr.Character then task.spawn(hook, lplr.Character) end

    local RANGES = { Volume = { 0, 10 }, Pitch = { 0.1, 4 }, Variance = { 0, 1 }, Cooldown = { 0, 5 } }
    function S.snapshot()
        local out = {}
        for _, n in ipairs({ "Hit", "Death" }) do
            local k, sel = S[n], {}
            for name in pairs(k.Selected) do sel[#sel + 1] = name end
            table.sort(sel)
            out[n] = { Enabled = k.Enabled, Folder = k.Folder, Volume = k.Volume, Pitch = k.Pitch,
                       Variance = k.Variance, Cooldown = k.Cooldown, Selected = sel }
        end
        return out
    end
    function S.apply(t)
        if type(t) ~= "table" then return end
        for _, n in ipairs({ "Hit", "Death" }) do
            local c, k = t[n], S[n]
            if type(c) == "table" then
                if type(c.Enabled) == "boolean" then k.Enabled = c.Enabled end
                if type(c.Folder) == "string" and #c.Folder > 0 and #c.Folder < 200 then k.Folder = c.Folder end
                for key, r in pairs(RANGES) do
                    local v = c[key]
                    if type(v) == "number" and v == v then k[key] = math.clamp(v, r[1], r[2]) end
                end
                k.Selected = {}
                if type(c.Selected) == "table" then
                    for _, nm in ipairs(c.Selected) do
                        if type(nm) == "string" then k.Selected[nm] = true end
                    end
                end
                S.scan(k)
            end
        end
    end
    function S.cleanup()
        for _, c in ipairs(S.conns) do pcall(function() c:Disconnect() end) end
        S.conns = {}
        S.Hit.Enabled, S.Death.Enabled = false, false
    end

    task.spawn(function() S.scan(S.Hit); S.scan(S.Death) end)
end)()

