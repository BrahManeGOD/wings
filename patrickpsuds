RunService.RenderStepped:Connect(BW(function(dt)
    if not (char and char.Parent and hum and hum.Health > 0
            and torso and rootPart and rwing and rm1 and wingBaseC0 and mod) then
        return
    end

    sine = sine + 1
    Hue  = (Hue + 1) % 360
    -- Asymmetric wing beat: the forward return stroke is quick, the back sweep is slower.
    -- frame-rate independent. Consistent blends smoothly between the return and sweep speeds
    -- (no hard switch, so the beat never speeds up, slows down and speeds up again); Off keeps one steady speed.
    local flapStep = FLAP.Speed * math.clamp(dt or 0.016, 0, 0.1) * 60
    if FLAP.ModeIndex == 1 then
        local blend = 0.5 + 0.5 * math.cos(flapPhase / 20)
        flapStep = flapStep * (FLAP.SweepSpeed + (FLAP.ReturnSpeed - FLAP.SweepSpeed) * blend)
    end
    flapPhase = flapPhase + flapStep

    updateBeat()

    --======= COLOR =======
    local cmode = COLOR_MODES[COLORCFG.ModeIndex]
    local phase = os.clock() * COLORCFG.Speed
    if cmode == "Static" then
        CurrentColor = COLORCFG.Static
    elseif cmode == "Gradient" then
        CurrentColor = sampleGradient(phase)
    else
        local mode = COLOR_LIST[currentColorIndex]
        local L = loudnessPeak
        local col
        if mode == "aEa" then
            local s = math.random(0, 255); col = Color3.new(s / 255, s / 355, 0)
        elseif mode == "N4N" or mode == "N0X" then
            col = Color3.fromRGB(255, 255, 255)
        elseif mode == "|" then
            col = Color3.fromRGB(math.random(99, 149), 0, 0)
        elseif mode == "Insanity" then
            local z = math.random(0, 255); col = Color3.fromRGB(z, z, z)
        elseif mode == "uncolored" then
            local v = math.min(1, L * 2); col = Color3.new(v, v, v)
        elseif mode == "Err0r" then
            col = Color3.fromRGB(225, 225, 225)
        elseif mode == "Err0r2" then
            local v = math.clamp(L * 500 - 100, 0, 255); col = Color3.fromRGB(v, v, 0)
        elseif mode == "FAST BOIII" then
            local v = math.clamp(L * 500 - 100, 0, 255); col = Color3.fromRGB(0, 0, v)
        elseif mode == "idk" then
            local v = math.clamp(L * 500 - 100, 0, 255); col = Color3.fromRGB(0, v, v)
        elseif mode == "error?" then
            col = Color3.fromRGB(0, math.random(0, 255), 0)
        elseif mode == "Glitch" then
            col = Color3.fromHSV((sine % 360) / 360, 1, math.clamp(L * 2 - 0.3, 0, 1))
        elseif mode == "unholy" then
            col = Color3.fromRGB(math.clamp(178 * L * 2, 0, 255), 0, 0)
        elseif mode == "Banisher2" then
            col = Color3.fromHSV(Hue / 360, 1, 1)
        else
            col = Color3.fromHSV((sine % 360) / 360, 1, 1)
        end
        CurrentColor = col
    end

    --======= WINGS: SUBTLE FLAP =======
    setwings(SETWINGS_TAB, 10)

    local ani = 0.2 * FLAP.Amp * math.sin(flapPhase / 20)
    local flapExtra = math.sin(flapPhase / 14) * FLAP.Extra

    local obvel = torso.CFrame:vectorToObjectSpace(torso.Velocity)
    local sspd, uspd, fspd = obvel.X, obvel.Y, obvel.Z
    local x, y, z = fspd / 160 * FLAP.Velocity, uspd / 700 * FLAP.Velocity, sspd / 900 * FLAP.Velocity

    local pdt = math.clamp(dt or 0.016, 0, 0.05)
    local function moveJoint(j, tx, ty, tz)
        if FLAP.PhysOn then
            local st = physState[j]
            if not st then st = { p = Vector3.new(tx, ty, tz), v = Vector3.zero }; physState[j] = st end
            local target = Vector3.new(tx, ty, tz)
            -- semi-implicit Euler, split in small steps so large stiffness stays stable
            local steps = math.max(1, math.ceil(pdt / 0.008))
            local h = pdt / steps
            for _ = 1, steps do
                st.v = st.v + (FLAP.Stiffness * (target - st.p) - FLAP.Damping * st.v) * h
                st.p = st.p + st.v * h
            end
            local pm = FLAP.PhysMax
            st.p = Vector3.new(math.clamp(st.p.X, -pm, pm), math.clamp(st.p.Y, -pm, pm), math.clamp(st.p.Z, -pm, pm))
            j.C0 = wingBaseC0[j] * CFrame.Angles(st.p.X, st.p.Y, st.p.Z)
        else
            physState[j] = nil
            j.C0 = j.C0:Lerp(wingBaseC0[j] * CFrame.Angles(tx, ty, tz), FLAP.Smooth)
        end
    end
    for i = 1, 4 do
        moveJoint(rwing[i],
            (ani * 0.1  * FLAP.XRight) + flapExtra + -mid(-0.1, x),
            0 + -mid(-0.1, y) + bn(i == 2) * 0.6,
            (ani * 0.02 * FLAP.Z)       + -mid(-0.1, z))
        moveJoint(lwing[i],
            (ani * -0.05 * FLAP.XLeft) - flapExtra + mid(-0.1, x),
            0 + mid(-0.1, y) + -bn(i == 2) * 0.6,
            (ani * 0.02 * FLAP.Z)       + mid(-0.1, z))
    end

    -- Feather rows get their own wave. The forward return stroke is faster, and
    -- the front row gets an extra snap so the wing looks like it is catching air.
    -- feathers just follow the setwings() pose (no wave), like the original animation

    --======= PART COLOR + GLOW + TRANSPARENCY + TRAIL =======
    local glow    = math.clamp(loudness * LIGHT.GlowSync, 0, 1)
    local white   = LIGHT.BeatColor
    local partT   = WINGS.Hidden and 1 or WINGS.Transparency
    local baseLE  = TRAIL.LightEmission
    local trailEm = math.clamp(baseLE + glow * (1 - baseLE) * LIGHT.TrailSync, 0, 1)
    local isGrad  = (cmode == "Gradient")
    local seq     = isGrad and gradientSequence(phase) or ColorSequence.new(CurrentColor)
    local tpos    = torso.Position
    for _, v in ipairs(mod:GetChildren()) do
        if v:IsA("BasePart") then
            local base = CurrentColor
            if isGrad then
                base = sampleGradient(phase + ((v.Position - tpos).Magnitude / 6) * COLORCFG.Spread)
            end
            v.Color = base:Lerp(white, glow)
            if v:GetAttribute("WingVisible") and v.Transparency ~= partT then
                v.Transparency = partT
            end
            local trail = v:FindFirstChild("WingTrail")
            if trail then
                trail.Color = seq
                trail.LightEmission = trailEm
            end
        end
    end

    --======= WING LIGHTS =======
    if #lightObjs > 0 then
        local lc = LIGHT.FollowColor and CurrentColor or LIGHT.Color
        local br = math.clamp(LIGHT.Brightness * (1 + loudness * LIGHT.BeatBoost * 3), 0, 100)
        for _, l in ipairs(lightObjs) do
            if l.Parent then
                l.Color = lc
                l.Brightness = br
            end
        end
    end
end))

