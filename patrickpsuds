;(function()
    -- shared UI state lives in one table: each field costs no register slot, which keeps the
    -- IIFE below Luau's hard 200-register limit ("Out of local registers" compile error)
    local UISTATE = {
        ruin = Color3.fromRGB(0, 0, 0),      -- was UISTATE.ruin
        curGroup = "global",
        activeTab = "media",
        loadingCfg = false,
        guiVisible = true,
        panelOpen = false,
        lastPanelVisible = false,
    }
    local themed     = { global = {}, media = {}, audio = {}, wing = {}, color = {}, player = {}, stuff = {}, sounds = {}, settings = {} }
    local themedFill = { global = {}, media = {}, audio = {}, wing = {}, color = {}, player = {}, stuff = {}, sounds = {}, settings = {} }
    local refreshers = {}
    local function refreshAll() for _, f in ipairs(refreshers) do pcall(f) end end

    local playerGui = lplr:WaitForChild("PlayerGui")
    for _, old in ipairs(playerGui:GetChildren()) do
        if old:IsA("ScreenGui") and (old.Name:match("^WingsUI_") or old.Name == "BoredomStatsHUD") then
            pcall(function() old:Destroy() end)
        end
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "WingsUI_" .. randomstring()
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 2147483000
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = lplr:WaitForChild("PlayerGui")
    _G.__BoredomWingsMainGui = gui

    local function place(obj, parent)
        local n = (parent:GetAttribute("n") or 0) + 1
        parent:SetAttribute("n", n)
        obj.LayoutOrder = n
        obj.Parent = parent
    end

    local function makeDraggable(frame, handle)
        handle = handle or frame
        local dragging, dragStart, startPos = false, nil, nil
        handle.InputBegan:Connect(BW(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = frame.Position
            end
        end))
        UIS.InputChanged:Connect(BW(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local d = input.Position - dragStart
                frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        UIS.InputEnded:Connect(BW(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end))
    end
    _G.__BoredomWingsDrag = makeDraggable

    local function styleText(obj)
        obj.Font = Enum.Font.Arcade
        obj.TextScaled = true
        obj.TextStrokeColor3 = UISTATE.ruin
        obj.TextStrokeTransparency = 0
        obj.TextColor3 = UISTATE.ruin
        local list = themed[UISTATE.curGroup]
        list[#list + 1] = obj
    end

    local function makeButton(parent, text, size, onClick)
        local btn = Instance.new("TextButton")
        btn.Size = size
        btn.BorderSizePixel = 0
        btn.BackgroundTransparency = 0.5
        btn.BackgroundColor3 = Color3.new(.5, .5, .5)
        btn.Text = text
        styleText(btn)
        place(btn, parent)
        if onClick then btn.MouseButton1Click:Connect(BW(onClick)) end
        return btn
    end

    local function makeLabel(parent, text, height, alignLeft)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, -8, 0, height)
        l.BackgroundTransparency = 1
        l.Text = text
        if alignLeft then l.TextXAlignment = Enum.TextXAlignment.Left end
        styleText(l)
        place(l, parent)
        return l
    end

    local function makeRow(parent, height)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -8, 0, height)
        row.BackgroundTransparency = 1
        local lay = Instance.new("UIListLayout")
        lay.FillDirection = Enum.FillDirection.Horizontal
        lay.Padding = UDim.new(0, 4)
        lay.SortOrder = Enum.SortOrder.LayoutOrder
        lay.Parent = row
        place(row, parent)
        return row
    end

    local function rowButtons(parent, height, defs)
        local row = makeRow(parent, height)
        local n = #defs
        local out = {}
        for i, d in ipairs(defs) do
            out[i] = makeButton(row, d[1], UDim2.new(1 / n, -4 * (n - 1) / n, 1, 0), d[2])
        end
        return out
    end

    local function makeSection(parent)
        local f = Instance.new("Frame")
        f.Size = UDim2.new(1, -8, 0, 0)
        f.AutomaticSize = Enum.AutomaticSize.Y
        f.BackgroundTransparency = 1
        local l = Instance.new("UIListLayout")
        l.Padding = UDim.new(0, 6)
        l.SortOrder = Enum.SortOrder.LayoutOrder
        l.Parent = f
        place(f, parent)
        return f
    end

    local function makeTextBox(size, placeholder)
        local b = Instance.new("TextBox")
        b.Size = size
        b.BackgroundColor3 = Color3.new(.5, .5, .5)
        b.BackgroundTransparency = 0.5
        b.BorderSizePixel = 0
        b.ClearTextOnFocus = false
        b.PlaceholderText = placeholder or ""
        b.Text = ""
        styleText(b)
        return b
    end

    local function sanitizeNumber(t, allowNeg)
        local neg = allowNeg and t:sub(1, 1) == "-"
        t = t:gsub("[^%d%.]", "")
        local dot = t:find(".", 1, true)
        if dot then t = t:sub(1, dot) .. (t:sub(dot + 1):gsub("%.", "")) end
        return (neg and "-" or "") .. t
    end

    -- one global drag tracker for every slider
    local activeSlider
    UIS.InputChanged:Connect(BW(function(input)
        if activeSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            activeSlider.fromX(input.Position.X)
        end
    end))
    UIS.InputEnded:Connect(BW(function(input)
        if activeSlider and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            local a = activeSlider
            activeSlider = nil
            a.s.Dragging = false
            if a.o.onCommit then a.o.onCommit(a.s.Value) end
        end
    end))

    -- slider + numbers-only textbox (box and slider stay in sync, box is clamped to min/max)
    local function makeSlider(parent, o)
        local s = { Min = o.min, Max = o.max, Value = o.default, Dragging = false }
        local decimals = o.decimals or 2
        local step = 10 ^ decimals
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -8, 0, o.noLabel and 18 or 46)
        row.BackgroundTransparency = 1
        place(row, parent)
        local box
        if not o.noLabel then
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(0.6, 0, 0, 22)
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Text = o.name
            styleText(label)
            label.Parent = row
            box = makeTextBox(UDim2.new(0.4, 0, 0, 22))
            box.Position = UDim2.new(0.6, 0, 0, 0)
            box.Parent = row
        end
        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(1, 0, 0, 14)
        bar.Position = UDim2.new(0, 0, 0, o.noLabel and 2 or 28)
        bar.BackgroundColor3 = Color3.new(.2, .2, .2)
        bar.BackgroundTransparency = 0.4
        bar.BorderSizePixel = 0
        bar.Parent = row
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(0, 0, 1, 0)
        fill.BorderSizePixel = 0
        fill.BackgroundColor3 = UISTATE.ruin
        fill.Parent = bar
        local fl = themedFill[UISTATE.curGroup]
        fl[#fl + 1] = fill

        local function render()
            local rel = (s.Max > s.Min) and math.clamp((s.Value - s.Min) / (s.Max - s.Min), 0, 1) or 0
            fill.Size = UDim2.new(rel, 0, 1, 0)
            if box and not box:IsFocused() then
                box.Text = string.format("%." .. decimals .. "f", s.Value)
            end
        end
        function s.Set(v) s.Value = v; render() end
        if o.tbl then
            refreshers[#refreshers + 1] = function()
                local v = o.tbl[o.key]
                if type(v) ~= "number" then return end
                v = math.clamp(v, s.Min, s.Max)
                o.tbl[o.key] = v
                s.Set(v)
                if UISTATE.loadingCfg and o.onChange then o.onChange(v) end
            end
        end

        local function fromX(x)
            local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
            local v = s.Min + (s.Max - s.Min) * rel
            s.Value = math.floor(v * step + 0.5) / step
            render()
            if o.onChange then o.onChange(s.Value) end
        end
        bar.InputBegan:Connect(BW(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                s.Dragging = true
                activeSlider = { s = s, o = o, fromX = fromX }
                fromX(input.Position.X)
            end
        end))
        if box then
            local allowNeg = o.min < 0
            box:GetPropertyChangedSignal("Text"):Connect(BW(function()
                local cleaned = sanitizeNumber(box.Text, allowNeg)
                if cleaned ~= box.Text then box.Text = cleaned end
            end))
            box.FocusLost:Connect(BW(function()
                local v = tonumber(box.Text)
                if v then
                    v = math.floor(math.clamp(v, s.Min, s.Max) * step + 0.5) / step
                    s.Value = v
                    if o.onChange then o.onChange(v) end
                    if o.onCommit then o.onCommit(v) end
                end
                render()
            end))
        end
        render()
        s.frame = row  -- exposed for sibling widgets (e.g. loop toggle)
        return s
    end

    local function makeToggle(parent, label, get, set, height)
        local btn
        local function refresh() btn.Text = label .. ": " .. (get() and "On" or "Off") end
        btn = makeButton(parent, "", UDim2.new(1, -8, 0, height or 32), function() set(not get()); refresh() end)
        refreshers[#refreshers + 1] = refresh
        refresh()
        return btn
    end

    local function makeCycle(parent, label, names, get, set, height)
        local btn
        local function refresh() btn.Text = label .. ": " .. tostring(names[get()]) end
        btn = makeButton(parent, "", UDim2.new(1, -8, 0, height or 32), function()
            set(get() % #names + 1)
            refresh()
        end)
        refreshers[#refreshers + 1] = refresh
        refresh()
        return btn
    end

    -- swatch | hex box | "R, G, B" box | optional X button
    local function makeColorEditor(parent, get, set, onRemove, noRegister)
        local row = makeRow(parent, 30)
        local sw = Instance.new("Frame")
        sw.Size = UDim2.new(0, 28, 1, 0)
        sw.BorderSizePixel = 1
        sw.BorderColor3 = Color3.new(1, 1, 1)
        place(sw, row)
        local hexBox = makeTextBox(UDim2.new(0.34, 0, 1, 0), "#RRGGBB")
        place(hexBox, row)
        local rgbBox = makeTextBox(UDim2.new(0.44, 0, 1, 0), "R, G, B")
        place(rgbBox, row)
        local function refresh()
            local c = get()
            sw.BackgroundColor3 = c
            hexBox.Text = toHex(c)
            rgbBox.Text = toRgbText(c)
        end
        local function commit(box)
            local c = parseColor(box.Text)
            if c then set(c) end
            refresh()
        end
        hexBox.FocusLost:Connect(BW(function() commit(hexBox) end))
        rgbBox.FocusLost:Connect(BW(function() commit(rgbBox) end))
        if onRemove then makeButton(row, "X", UDim2.new(0, 28, 1, 0), onRemove) end
        if not noRegister then refreshers[#refreshers + 1] = refresh end
        refresh()
        return row
    end

    local function fmtTime(t)
        t = math.max(0, math.floor((t or 0) + 0.5))
        return string.format("%d:%02d", math.floor(t / 60), t % 60)
    end

    -------------------- Master button + panel --------------------
    local masterBtn = Instance.new("TextButton")
