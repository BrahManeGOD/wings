local function sampleGradient(t)
    local stops = COLORCFG.Stops
    local n = #stops
    if n == 0 then return Color3.new(1, 1, 1) end
    if n == 1 then return stops[1] end
    if COLORCFG.Loop then
        local u = (t % 1) * n
        local i = math.floor(u)
        return stops[i % n + 1]:Lerp(stops[(i + 1) % n + 1], u - i)
    else
        local m = t % 2
        local u = (m <= 1 and m or 2 - m) * (n - 1)
        local i = math.min(math.floor(u), n - 2)
        return stops[i + 1]:Lerp(stops[i + 2], u - i)
    end
end

local function gradientSequence(phase)
    local N = 6
    local kps = {}
    for i = 0, N do
        kps[#kps + 1] = ColorSequenceKeypoint.new(i / N, sampleGradient(phase + (i / N) * COLORCFG.Spread))
    end
    return ColorSequence.new(kps)
end

