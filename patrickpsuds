local function sortEntries(list)
    table.sort(list, function(a, b)
        local fa, fb = favorites[a.file] and 1 or 0, favorites[b.file] and 1 or 0
        if fa ~= fb then return fa > fb end
        return a.name:lower() < b.name:lower()
    end)
end

local function listMp3(folder)
    local out = {}
    local ok, files = pcall(listfiles, folder)
    if ok and type(files) == "table" then
        for _, path in ipairs(files) do
            local norm = tostring(path):gsub("\\", "/")
            if norm:lower():match("%.mp3$") then
                local file = norm:match("([^/]+)$") or norm
                local name = file:gsub("%.[Mm][Pp]3$", "")
                out[#out + 1] = { name = name, file = file, path = path }
            end
        end
    end
    return out
end

local function listFolders(folder)
    local out = {}
    local ok, files = pcall(listfiles, folder)
    if ok and type(files) == "table" then
        for _, path in ipairs(files) do
            local okd, isDir = pcall(isfolder, path)
            if okd and isDir then
                local norm = tostring(path):gsub("\\", "/")
                local name = norm:match("([^/]+)/?$")
                if name and name:sub(1, 1) ~= "." then out[#out + 1] = name end
            end
        end
    end
    table.sort(out, function(a, b) return a:lower() < b:lower() end)
    return out
end

local function getSources()
    local list = { { kind = "library", label = "All Songs" }, { kind = "favs", label = "Favorites" } }
    for _, n in ipairs(playlistNames) do list[#list + 1] = { kind = "playlist", label = n } end
    return list
end

local function songsOf(src)
    local list = {}
    if src.kind == "library" then
        for _, e in ipairs(libraryEntries) do list[#list + 1] = e end
    elseif src.kind == "playlist" then
        for _, e in ipairs(playlistEntries[src.label] or {}) do list[#list + 1] = e end
    else
        local seen = {}
        local function addFrom(es)
            for _, e in ipairs(es) do
                if favorites[e.file] and not seen[e.file] then
                    seen[e.file] = true
                    list[#list + 1] = e
                end
            end
        end
        addFrom(libraryEntries)
        for _, n in ipairs(playlistNames) do addFrom(playlistEntries[n] or {}) end
    end
    sortEntries(list)
    return list
end

local CACHE_DIR = PATHS.Root .. "/.cache"

local function pathHash(s)
    local h = 5381
    for i = 1, #s do h = (h * 33 + s:byte(i)) % 4294967291 end
    return h
end

local function loadEntry(idx)
    local entry = playlist[idx]
    if not entry then return false end
    nowPlaying = entry
    loadToken = loadToken + 1
    local token = loadToken

    -- point the Sound at one asset and wait for it to report a length
    local function tryAsset(asset)
        music:Stop()
        music.SoundId = asset
        music.TimePosition = 0
        pcall(function() game:GetService("ContentProvider"):PreloadAsync({ music }) end)
        local t0 = os.clock()
        while token == loadToken and not (music.IsLoaded and music.TimeLength > 0) and os.clock() - t0 < 10 do
            task.wait(0.05)
        end
        if token ~= loadToken then return "superseded" end
        if music.TimeLength > 0 then return "ok" end
        return nil
    end

    local asset = assetCache[entry.path]
    local result, why
    if not asset then
        local ok, res = pcall(getAsset, entry.path)
        if ok and type(res) == "string" and res ~= "" then asset = res else why = "getcustomasset failed: " .. tostring(res) end
    end
    if asset then
        result = tryAsset(asset)
        if result == "superseded" then return true end
        if not result then why = "Roblox returned no audio length for this file" end
    end

    -- fallback: file names with odd characters sometimes break getcustomasset, so copy to a plain name and retry
    if not result and hasCopy then
        pcall(function() if not isfolder(CACHE_DIR) then makefolder(CACHE_DIR) end end)
        local plain = string.format("%s/track_%d.mp3", CACHE_DIR, pathHash(entry.path))
        local okRead, data = pcall(readfile, entry.path)
        if okRead and type(data) == "string" and #data > 0 and pcall(writefile, plain, data) then
            local ok2, res2 = pcall(getAsset, plain)
            if ok2 and type(res2) == "string" and res2 ~= "" then
                result = tryAsset(res2)
                if result == "superseded" then return true end
                if result then asset = res2 end
            end
        end
    end

    if not result then
        badPaths[entry.path] = why or "could not load"
        warn("[Wings] " .. entry.name .. " -> " .. badPaths[entry.path])
        return false
    end

    assetCache[entry.path] = asset
    badPaths[entry.path] = nil
    if AUDIO.RegionOn then
        pcall(function()
            if AUDIO.RegionEnd > AUDIO.RegionStart then
                music.PlaybackRegionsEnabled = true
                music.PlaybackRegion = NumberRange.new(AUDIO.RegionStart, AUDIO.RegionEnd)
                music.LoopRegion = NumberRange.new(AUDIO.RegionStart, AUDIO.RegionEnd)
            end
        end)
    end
    applyVolume()
    if not paused then
        music:Play()
        local t1 = os.clock()
        while token == loadToken and not music.IsPlaying and os.clock() - t1 < 2 do task.wait(0.05) end
        if token == loadToken and not music.IsPlaying then music.Playing = true end
    end
    return true
end

local function playEntry(idx, dir)
    dir = dir or 1
    local n = #playlist
    for _ = 1, n do
        currentIndex = idx
        if loadEntry(idx) then return true end
        idx = (idx - 1 + dir) % n + 1
    end
    music:Stop()
    warn("[Wings] No playable songs in this list")
    return false
end

local function pushHistory(entry, src)
    if not entry then return end
    history[#history + 1] = { entry = entry, src = src }
    if #history > 50 then table.remove(history, 1) end
end

local function goTo(idx, record, dir)
    if #playlist == 0 then return end
    idx = (idx - 1) % #playlist + 1
    local prev, prevSrc = nowPlaying, queueSrc
    if playEntry(idx, dir) and record and prev and nowPlaying and prev.path ~= nowPlaying.path then
        pushHistory(prev, prevSrc)
    end
end

local function nextTrack() goTo(currentIndex + 1, true, 1) end

local function prevTrack()
    local keepSrc, keepList = queueSrc, playlist
    while #history > 0 do
        local h = table.remove(history)
        queueSrc = h.src
        playlist = songsOf(queueSrc)
        for i, e in ipairs(playlist) do
            if e.path == h.entry.path then
                playEntry(i, -1)
                return
            end
        end
    end
    queueSrc, playlist = keepSrc, keepList
    if #playlist == 0 then return end
    goTo(currentIndex - 1, false, -1)
end

local function playFromSource(src, entry)
    local prev, prevSrc = nowPlaying, queueSrc
    queueSrc = src
    playlist = songsOf(src)
    for i, e in ipairs(playlist) do
        if e.path == entry.path then
            if playEntry(i, 1) and prev and nowPlaying and prev.path ~= nowPlaying.path then
                pushHistory(prev, prevSrc)
            end
            return
        end
    end
end

local function resortQueue()
    local cur = nowPlaying
    playlist = songsOf(queueSrc)
    currentIndex = 0
    if cur then
        for i, e in ipairs(playlist) do
            if e.path == cur.path then currentIndex = i break end
        end
    end
end

local function scanFolder()
    local prevPath = nowPlaying and nowPlaying.path
    libraryEntries, playlistNames, playlistEntries = {}, {}, {}
    if fsReady then
        libraryEntries = listMp3(MUSIC_FOLDER)
        playlistNames = listFolders(MUSIC_FOLDER)
        for _, n in ipairs(playlistNames) do
            playlistEntries[n] = listMp3(MUSIC_FOLDER .. "/" .. n)
        end
    end
    print("[Wings] scanned " .. #libraryEntries .. " mp3 file(s) and " .. #playlistNames .. " playlist(s) in " .. MUSIC_FOLDER)
    if queueSrc.kind == "playlist" and not playlistEntries[queueSrc.label] then
        queueSrc = { kind = "library", label = "All Songs" }
    end
    playlist = songsOf(queueSrc)
    local newIndex = 0
    if prevPath then
        for i, e in ipairs(playlist) do
            if e.path == prevPath then newIndex = i break end
        end
    end
    if #playlist == 0 then
        currentIndex = 0
        nowPlaying = nil
        music:Stop()
        music.SoundId = ""
    elseif newIndex > 0 then
        currentIndex = newIndex
    else
        currentIndex = 0
        playEntry(1, 1)
    end
    uiRefreshSongs()
    return #libraryEntries
end

