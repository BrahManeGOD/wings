    local function applyNoFogOnce()
        Lighting.FogEnd = 1e9
        Lighting.FogStart = 1e9
        for _, a in ipairs(Lighting:GetChildren()) do
            if a:IsA("Atmosphere") then
                if fogSaved and not fogSaved.atm[a] then fogSaved.atm[a] = { Density = a.Density, Haze = a.Haze } end
                a.Density = 0
                a.Haze = 0
            end
        end
    end
