-- forward declarations: the watchdog below must capture these real locals,
-- otherwise it would read nil globals (silent no-op pcall / missing busy check)
local attachMusicToTorso
local busy = false
-- Watchdog: revive music playback if the Sound lost its parent or stopped
-- unexpectedly (happens when musicPart is destroyed on character reset)
task.spawn(function()
    while not KILL.dead do
        task.wait(2)
        if nowPlaying and not paused and not busy then
            -- Sound lost its parent — re-parent it to a fresh/existing musicPart
            if not music.Parent then
                if torso then pcall(attachMusicToTorso)
                elseif musicPart and musicPart.Parent then music.Parent = musicPart end
            end
            -- weld is gone but we have a torso — re-attach
            if torso and (not musicWeld or not musicWeld.Parent) then
                pcall(attachMusicToTorso)
            end
            -- Sound exists but stopped playing — resume at saved position
            if music.Parent and not music.IsPlaying then
                local sid = music.SoundId
                if sid and sid ~= "" then
                    local pos = music.TimePosition
                    pcall(function() music.TimePosition = pos; music:Play() end)
                end
            end
        end
    end
end)

local loudness, loudnessPeak = 0, 0
local function updateBeat()
    local raw = math.clamp((music.PlaybackLoudness or 0) / 1000, 0, 1)
    loudness = lerp(loudness, raw, 1 - SYNC_SMOOTHING)
    if loudness > loudnessPeak then
        loudnessPeak = loudness
    else
        loudnessPeak = lerp(loudnessPeak, loudness, 0.02)
    end
end

function attachMusicToTorso()   -- assigns the forward-declared local above
    if not torso then return end
    -- if musicPart was destroyed (e.g. it was welded to the torso which got cleaned up),
    -- make a new one and re-parent the Sound so it stays alive
    if not musicPart or not musicPart.Parent then
        local np = Instance.new("Part")
        np.Name = randomstring(); np.Size = Vector3.new(2,2,2)
        np.Transparency = 1; np.CanCollide = false; np.Anchored = true
        np.Massless = true; np.CanTouch = false; np.CanQuery = false
        np.Parent = workspace
        music.Parent = np
        musicPart = np
    end
    if musicWeld then pcall(function() musicWeld:Destroy() end); musicWeld = nil end
    musicPart.Anchored = true
    musicPart.CFrame   = torso.CFrame
    musicWeld = Instance.new("Weld")
    musicWeld.Name   = "MusicWeld"
    musicWeld.Part0  = torso
    musicWeld.Part1  = musicPart
    musicWeld.C0     = CFrame.new(AUDIO.OffX, AUDIO.OffY, AUDIO.OffZ)
    musicWeld.C1     = CFrame.new()
    musicWeld.Parent = torso
    musicPart.Anchored = false
end

--========================================================
-- PLAYLIST OPERATIONS
--========================================================
local function runOp(fn)
    if busy then statusText = "Busy - wait for the current operation" return end
    busy = true
    task.spawn(function()
        local ok, err = pcall(fn)
        busy = false
        if not ok then
            statusText = "Error: " .. tostring(err)
            warn("[Wings] " .. tostring(err))
        end
    end)
end

local pending
local function confirmed(kind, name)
    if pending and pending.kind == kind and pending.name == name and tick() - pending.t < 5 then
        pending = nil
        return true
    end
    pending = { kind = kind, name = name, t = tick() }
    return false
end

local function sanitizeName(s)
    s = tostring(s or "")
    s = s:gsub('[\\/:*?"<>|%c]', "")
    s = s:gsub("^%s+", ""):gsub("%s+$", "")
    if s == "." or s == ".." then s = "" end
    return s:sub(1, 40)
end
local function folderExists(path)
    local ok, r = pcall(isfolder, path)
    return (ok and r) and true or false
end
local function copyFile(src, dst)
    local ok, data = pcall(readfile, src)
    if not ok or type(data) ~= "string" then return false end
    return (pcall(writefile, dst, data))
end
local function wipeFolderFiles(folder)
    local ok, files = pcall(listfiles, folder)
    if ok and type(files) == "table" then
        for _, p in ipairs(files) do pcall(delfile, p) end
    end
end

local function createPlaylist(rawName)
    local name = sanitizeName(rawName)
    if name == "" then statusText = "Type a playlist name first" return end
    local folder = MUSIC_FOLDER .. "/" .. name
    if folderExists(folder) then
        if not (hasDel) then statusText = "Executor lacks delfile - cannot overwrite" return end
        if not confirmed("overwrite", name) then
            statusText = "'" .. name .. "' exists. Press Create again within 5s to OVERWRITE it (clears its songs)"
            return
        end
        runOp(function()
            wipeFolderFiles(folder)
            statusText = "Overwrote playlist '" .. name .. "' (now empty)"
            requestBrowse = name
            scanFolder()
        end)
        return
    end
    runOp(function()
        local ok = pcall(makefolder, folder)
        statusText = ok and ("Created playlist '" .. name .. "'") or "Could not create the folder"
        requestBrowse = name
        scanFolder()
    end)
end

local function renamePlaylist(old, rawNew)
    if not old then statusText = "Browse to a playlist first (use < > above)" return end
    local new = sanitizeName(rawNew)
    if new == "" then statusText = "Type the new name first" return end
    if new == old then return end
    if not (hasCopy and hasDel and hasDelFolder) then statusText = "Executor lacks readfile/writefile/delfile/delfolder" return end
    local newFolder = MUSIC_FOLDER .. "/" .. new
    if folderExists(newFolder) then statusText = "A playlist named '" .. new .. "' already exists" return end
    runOp(function()
        pcall(makefolder, newFolder)
        local allOk = true
        for _, e in ipairs(playlistEntries[old] or {}) do
            if not copyFile(e.path, newFolder .. "/" .. e.file) then allOk = false break end
        end
        if not allOk then
            wipeFolderFiles(newFolder)
            pcall(delfolder, newFolder)
            statusText = "Rename failed while copying - original kept"
            return
        end
        local oldFolder = MUSIC_FOLDER .. "/" .. old
        wipeFolderFiles(oldFolder)
        pcall(delfolder, oldFolder)
        statusText = "Renamed '" .. old .. "' to '" .. new .. "'"
        requestBrowse = new
        scanFolder()
    end)
end

local function deletePlaylist(name)
    if not name then statusText = "Browse to a playlist first (use < > above)" return end
    if not (hasDel and hasDelFolder) then statusText = "Executor lacks delfile/delfolder" return end
    if not confirmed("delete", name) then
        statusText = "Press Delete again within 5s to delete '" .. name .. "' and its songs"
        return
    end
    runOp(function()
        local folder = MUSIC_FOLDER .. "/" .. name
        wipeFolderFiles(folder)
        local ok = pcall(delfolder, folder)
        statusText = ok and ("Deleted playlist '" .. name .. "'") or "Songs removed but the folder could not be deleted"
        scanFolder()
    end)
end

local function addToPlaylist(entry, name)
    if not name then statusText = "Create a playlist first, then pick it with Add to: < >" return end
    if not hasCopy then statusText = "Executor lacks readfile/writefile" return end
    for _, e in ipairs(playlistEntries[name] or {}) do
        if e.file:lower() == entry.file:lower() then
            statusText = "'" .. entry.name .. "' is already in '" .. name .. "'"
            return
        end
    end
    runOp(function()
        local ok = copyFile(entry.path, MUSIC_FOLDER .. "/" .. name .. "/" .. entry.file)
        statusText = ok and ("Added '" .. entry.name .. "' to '" .. name .. "'") or "Copy failed"
        scanFolder()
    end)
end

local function removeFromPlaylist(entry)
    if not hasDel then statusText = "Executor lacks delfile" return end
    runOp(function()
        local ok = pcall(delfile, entry.path)
        statusText = ok and ("Removed '" .. entry.name .. "'") or "Could not delete the file"
        scanFolder()
    end)
end

local function swapInPlaylist(entry, picked, name)
    if not picked then statusText = "Use Pick on a song first, then Swap" return end
    if not (hasCopy and hasDel) then statusText = "Executor lacks readfile/writefile/delfile" return end
    runOp(function()
        if not copyFile(picked.path, MUSIC_FOLDER .. "/" .. name .. "/" .. picked.file) then
            statusText = "Copy failed - nothing changed"
            return
        end
        if picked.file:lower() ~= entry.file:lower() then pcall(delfile, entry.path) end
        statusText = "Replaced '" .. entry.name .. "' with '" .. picked.name .. "'"
        scanFolder()
    end)
end

